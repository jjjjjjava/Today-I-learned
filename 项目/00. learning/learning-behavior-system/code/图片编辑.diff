+    /**
+     * 閲婃斁璧勬簮
+     */
+    public void release() {
+        // 閲婃斁 FBO
+        if (mFBOManager != null && mRenderFBO != null) {
+            mFBOManager.deleteFBO(mRenderFBO);
+            mRenderFBO = null;
+        }
+        
+        // 閲婃斁绾圭悊
+        if (mBaseTextureId != -1) {
+            int[] textures = {mBaseTextureId};
+            GLES20.glDeleteTextures(1, textures, 0);
+            mBaseTextureId = -1;
+        }
+        
+        // 閲婃斁 Shader
+        if (mShaderManager != null) {
+            mShaderManager.release();
+            mShaderManager = null;
+        }
+        
+        // 閲婃斁 Bitmap
+        if (mBaseBitmap != null && !mBaseBitmap.isRecycled()) {
+            mBaseBitmap.recycle();
+            mBaseBitmap = null;
+        }
+    }
