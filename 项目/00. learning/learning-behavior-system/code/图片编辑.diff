+                if (progress < 5) {
+                    progress = 5;
+                    seekBar.setProgress(5);
+                }
+                
+                // 鏇存柊绾垮
+                // SeekBar: 5~50 -> OpenGL: 0.005f~0.05f
+                mCurrentStrokeWidth = progress / 1000.0f;
