index 0000000000..df9cb85298
--- /dev/null
+++ b/lib_edit/src/main/java/com/ovopark/edit/gl/PerformanceStats.java
@@ -0,0 +1,65 @@
+package com.ovopark.edit.gl;
+
+import android.util.Log;
+
+/**
+ * 鎬ц兘缁熻宸ュ叿锛堣交閲忕骇锛?+ * 鐢ㄤ簬瀵规瘮FBO vs CPU鐢诲竷鎬ц兘
+ */
+public class PerformanceStats {
+    
+    private static final String TAG = "PERF_COMPARE";
+    
+    private final String mName;
+    private long mFrameCount = 0;
+    private long mTotalTimeNs = 0;
+    private long mMinTimeNs = Long.MAX_VALUE;
+    private long mMaxTimeNs = 0;
+    
+    public PerformanceStats(String name) {
+        this.mName = name;
+    }
+    
+    /**
+     * 璁板綍涓€娆℃覆鏌撹€楁椂
+     * @param durationNs 鑰楁椂锛堢撼绉掞級
+     */
+    public void record(long durationNs) {
+        mFrameCount++;
+        mTotalTimeNs += durationNs;
+        mMinTimeNs = Math.min(mMinTimeNs, durationNs);
+        mMaxTimeNs = Math.max(mMaxTimeNs, durationNs);
+        
+        // 姣?00甯ц緭鍑轰竴娆＄粺璁?+        if (mFrameCount % 100 == 0) {
+            printStats();
+            reset();
+        }
+    }
+    
+    private void printStats() {
+        double avgMs = (mTotalTimeNs / mFrameCount) / 1_000_000.0;
+        double minMs = mMinTimeNs / 1_000_000.0;
+        double maxMs = mMaxTimeNs / 1_000_000.0;
+        
+        Log.i(TAG, String.format("銆?s銆?00甯х粺璁? 骞冲潎%.2fms | 鏈€蹇?.2fms | 鏈€鎱?.2fms", 
+                mName, avgMs, minMs, maxMs));
+    }
+    
+    private void reset() {
+        mFrameCount = 0;
+        mTotalTimeNs = 0;
+        mMinTimeNs = Long.MAX_VALUE;
+        mMaxTimeNs = 0;
+    }
+    
+    /**
+     * 绔嬪嵆杈撳嚭褰撳墠缁熻锛堢敤浜庢墜鍔ㄥ姣旓級
+     */
+    public void printNow() {
+        if (mFrameCount > 0) {
+            printStats();
+        }
+    }
+}
