diff --git a/lib_edit/src/main/java/com/ovopark/edit/ToolSwitchCoordinator.java b/lib_edit/src/main/java/com/ovopark/edit/ToolSwitchCoordinator.java
new file mode 100644
index 0000000000..8308d5175b
--- /dev/null
+++ b/lib_edit/src/main/java/com/ovopark/edit/ToolSwitchCoordinator.java
@@ -0,0 +1,296 @@
+package com.ovopark.edit;
+
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.util.Log;
+
+import com.ovopark.edit.gl.GLEditView;
+
+/**
+ * 宸ュ叿鍒囨崲鍗忚皟鍣?+ * 璐熻矗鍗忚皟 OpenGL 宸ュ叿鍜屽弻灞傜敾甯冨伐鍏蜂箣闂寸殑鍒囨崲
+ * 
+ * 鏍稿績鍔熻兘锛?+ * 1. OpenGL 鈫?鍙屽眰鐢诲竷锛氭崟鑾?OpenGL 鍐呭骞跺悎骞跺埌 mainBitmap
+ * 2. 鍙屽眰鐢诲竷 鈫?OpenGL锛氭洿鏂?OpenGL 鐨勫熀纭€鍥剧墖涓烘渶鏂扮殑 mainBitmap
+ * 3. OpenGL 鍐呴儴鍒囨崲锛氶€氳繃鍏变韩灞傛満鍒惰嚜鍔ㄥ鐞?+ * 
+ * @author panruiqi
+ * @since 1.0.0
+ */
+public class ToolSwitchCoordinator {
+    
+    private static final String TAG = "ToolSwitchCoordinator";
+    
+    /**
+     * Activity 寮曠敤
+     */
+    private final EditImageActivity mActivity;
+    
+    /**
+     * 褰撳墠宸ュ叿绫诲瀷
+     */
+    private ToolMode mCurrentMode = ToolMode.NONE;
+    
+    /**
+     * 鍒囨崲鍥炶皟
+     */
+    private SwitchCallback mSwitchCallback;
+    
+    /**
+     * 宸ュ叿妯″紡鏋氫妇
+     */
+    public enum ToolMode {
+        NONE,           // 鏃犲伐鍏?+        OPENGL,         // OpenGL 宸ュ叿锛堢澶淬€佺煩褰㈢瓑锛?+        CANVAS          // 鍙屽眰鐢诲竷宸ュ叿锛堢敾绗斻€侀┈璧涘厠绛夛級
+    }
+    
+    /**
+     * 鍒囨崲鍥炶皟鎺ュ彛
+     */
+    public interface SwitchCallback {
+        /**
+         * 鍒囨崲寮€濮?+         */
+        void onSwitchStart();
+        
+        /**
+         * 鍒囨崲瀹屾垚
+         */
+        void onSwitchComplete();
+        
+        /**
+         * 鍒囨崲澶辫触
+         * 
+         * @param error 閿欒淇℃伅
+         */
+        void onSwitchError(String error);
+    }
+    
+    public ToolSwitchCoordinator(EditImageActivity activity) {
+        this.mActivity = activity;
+    }
+    
+    /**
+     * 璁剧疆鍒囨崲鍥炶皟
+     */
+    public void setSwitchCallback(SwitchCallback callback) {
+        this.mSwitchCallback = callback;
+    }
+    
+    /**
+     * 宸ュ叿鍒囨崲鍓嶇殑鍑嗗
+     * 
+     * @param fromMode 褰撳墠妯″紡
+     * @param toMode 鐩爣妯″紡
+     */
+    public void prepareSwitch(ToolMode fromMode, ToolMode toMode) {
+        Log.d(TAG, "prepareSwitch: " + fromMode + " -> " + toMode);
+        
+        if (fromMode == toMode) {
+            Log.d(TAG, "Same mode, no switch needed");
+            return;
+        }
+        
+        mCurrentMode = fromMode;
+        
+        if (mSwitchCallback != null) {
+            mSwitchCallback.onSwitchStart();
+        }
+        
+        // 鏍规嵁鍒囨崲绫诲瀷鎵ц涓嶅悓鐨勬搷浣?+        if (fromMode == ToolMode.OPENGL && toMode == ToolMode.CANVAS) {
+            // OpenGL 鈫?鍙屽眰鐢诲竷
+            switchFromOpenGLToCanvas();
+        } else if (fromMode == ToolMode.CANVAS && toMode == ToolMode.OPENGL) {
+            // 鍙屽眰鐢诲竷 鈫?OpenGL
+            switchFromCanvasToOpenGL();
+        } else if (fromMode == ToolMode.OPENGL && toMode == ToolMode.OPENGL) {
+            // OpenGL 鍐呴儴鍒囨崲锛堢敱鍏变韩灞傚鐞嗭紝鏃犻渶棰濆鎿嶄綔锛?+            Log.d(TAG, "OpenGL internal switch, handled by shared layer");
+            mCurrentMode = toMode;
+            if (mSwitchCallback != null) {
+                mSwitchCallback.onSwitchComplete();
+            }
+        } else if (fromMode == ToolMode.CANVAS && toMode == ToolMode.CANVAS) {
+            // 鍙屽眰鐢诲竷鍐呴儴鍒囨崲锛堢敱鍘熸湁閫昏緫澶勭悊锛?+            Log.d(TAG, "Canvas internal switch, handled by existing logic");
+            mCurrentMode = toMode;
+            if (mSwitchCallback != null) {
+                mSwitchCallback.onSwitchComplete();
+            }
+        } else {
+            // 浠?NONE 鍒囨崲鍒版煇涓伐鍏?+            mCurrentMode = toMode;
+            if (mSwitchCallback != null) {
+                mSwitchCallback.onSwitchComplete();
+            }
+        }
+    }
+    
+    /**
+     * OpenGL 鈫?鍙屽眰鐢诲竷鍒囨崲
+     * 
+     * 娴佺▼锛?+     * 1. 鎻愪氦褰撳墠 OpenGL 宸ュ叿鐨勫舰鐘跺埌鍏变韩灞?+     * 2. 鎹曡幏 OpenGL 娓叉煋缁撴灉锛堝簳鍥?+ 鍏变韩灞傦級
+     * 3. 灏嗘崟鑾风殑缁撴灉鍚堝苟鍒?mainBitmap
+     * 4. 娓呯┖ OpenGL 鍐呭
+     */
+    private void switchFromOpenGLToCanvas() {
+        Log.d(TAG, "Switching from OpenGL to Canvas");
+        
+        final GLEditView glEditView = mActivity.mGLEditView;
+        if (glEditView == null) {
+            Log.e(TAG, "GLEditView is null");
+            if (mSwitchCallback != null) {
+                mSwitchCallback.onSwitchError("GLEditView is null");
+            }
+            return;
+        }
+        
+        // 1. 鎻愪氦褰撳墠宸ュ叿鐨勫舰鐘跺埌鍏变韩灞?+        glEditView.commitCurrentTool();
+        
+        // 2. 鎹曡幏 OpenGL 娓叉煋缁撴灉
+        glEditView.captureResult(new GLEditView.CaptureResultCallback() {
+            @Override
+            public void onCaptureSuccess(Bitmap glBitmap) {
+                Log.d(TAG, "OpenGL content captured: " + glBitmap.getWidth() + "x" + glBitmap.getHeight());
+                
+                // 3. 鍚堝苟鍒?mainBitmap
+                Bitmap mergedBitmap = mergeBitmaps(mActivity.mainBitmap, glBitmap);
+                
+                if (mergedBitmap != null) {
+                    // 鏇存柊 mainBitmap
+                    mActivity.changeMainBitmap(mergedBitmap);
+                    
+                    // 4. 娓呯┖ OpenGL 鍐呭
+                    glEditView.clearAll();
+                    
+                    Log.d(TAG, "Switch from OpenGL to Canvas completed");
+                    mCurrentMode = ToolMode.CANVAS;
+                    
+                    if (mSwitchCallback != null) {
+                        mSwitchCallback.onSwitchComplete();
+                    }
+                } else {
+                    Log.e(TAG, "Failed to merge bitmaps");
+                    if (mSwitchCallback != null) {
+                        mSwitchCallback.onSwitchError("Failed to merge bitmaps");
+                    }
+                }
+                
+                // 閲婃斁涓存椂 bitmap
+                if (glBitmap != null && !glBitmap.isRecycled()) {
+                    glBitmap.recycle();
+                }
+            }
+            
+            @Override
+            public void onCaptureError(String error) {
+                Log.e(TAG, "Failed to capture OpenGL content: " + error);
+                if (mSwitchCallback != null) {
+                    mSwitchCallback.onSwitchError("Capture failed: " + error);
+                }
+            }
+        });
+    }
+    
+    /**
+     * 鍙屽眰鐢诲竷 鈫?OpenGL 鍒囨崲
+     * 
+     * 娴佺▼锛?+     * 1. 鏇存柊 OpenGL 鐨勫熀纭€鍥剧墖涓哄綋鍓嶇殑 mainBitmap
+     * 2. 锛堝弻灞傜敾甯冪殑鍐呭宸茬粡鍦?mainBitmap 涓級
+     */
+    private void switchFromCanvasToOpenGL() {
+        Log.d(TAG, "Switching from Canvas to OpenGL");
+        
+        final GLEditView glEditView = mActivity.mGLEditView;
+        if (glEditView == null) {
+            Log.e(TAG, "GLEditView is null");
+            if (mSwitchCallback != null) {
+                mSwitchCallback.onSwitchError("GLEditView is null");
+            }
+            return;
+        }
+        
+        // 鏇存柊 OpenGL 鐨勫熀纭€鍥剧墖
+        if (mActivity.mainBitmap != null && !mActivity.mainBitmap.isRecycled()) {
+            glEditView.setBaseImage(mActivity.mainBitmap);
+            Log.d(TAG, "Updated OpenGL base image");
+            
+            mCurrentMode = ToolMode.OPENGL;
+            if (mSwitchCallback != null) {
+                mSwitchCallback.onSwitchComplete();
+            }
+        } else {
+            Log.e(TAG, "mainBitmap is null or recycled");
+            if (mSwitchCallback != null) {
+                mSwitchCallback.onSwitchError("mainBitmap is invalid");
+            }
+        }
+    }
+    
+    /**
+     * 鍚堝苟涓や釜 Bitmap
+     * 
+     * @param baseBitmap 鍩虹鍥剧墖锛堜笅灞傦級
+     * @param overlayBitmap 瑕嗙洊鍥剧墖锛堜笂灞傦級
+     * @return 鍚堝苟鍚庣殑 Bitmap
+     */
+    private Bitmap mergeBitmaps(Bitmap baseBitmap, Bitmap overlayBitmap) {
+        if (baseBitmap == null) {
+            Log.e(TAG, "Base bitmap is null");
+            return overlayBitmap != null ? overlayBitmap.copy(Bitmap.Config.ARGB_8888, true) : null;
+        }
+        
+        if (overlayBitmap == null) {
+            Log.w(TAG, "Overlay bitmap is null, returning base bitmap");
+            return baseBitmap.copy(Bitmap.Config.ARGB_8888, true);
+        }
+        
+        try {
+            // 鍒涘缓鍙彉鐨勫壇鏈?+            Bitmap result = baseBitmap.copy(Bitmap.Config.ARGB_8888, true);
+            
+            // 鍒涘缓鐢诲竷骞剁粯鍒惰鐩栧眰
+            Canvas canvas = new Canvas(result);
+            Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+            canvas.drawBitmap(overlayBitmap, 0, 0, paint);
+            
+            Log.d(TAG, "Bitmaps merged successfully: " + result.getWidth() + "x" + result.getHeight());
+            return result;
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to merge bitmaps: " + e.getMessage(), e);
+            return null;
+        }
+    }
+    
+    /**
+     * 鑾峰彇褰撳墠宸ュ叿妯″紡
+     */
+    public ToolMode getCurrentMode() {
+        return mCurrentMode;
+    }
+    
+    /**
+     * 鍒ゆ柇鏄惁涓?OpenGL 宸ュ叿妯″紡
+     */
+    public static ToolMode getModeForEditMode(int editMode) {
+        switch (editMode) {
+            case EditImageActivity.MODE_GL_ARROW:
+            case EditImageActivity.MODE_GL_RECTANGLE:
+                return ToolMode.OPENGL;
+            case EditImageActivity.MODE_PAINT:
+            // 鍙互娣诲姞鍏朵粬鍙屽眰鐢诲竷妯″紡
+                return ToolMode.CANVAS;
+            default:
+                return ToolMode.NONE;
+        }
+    }
+}
+
