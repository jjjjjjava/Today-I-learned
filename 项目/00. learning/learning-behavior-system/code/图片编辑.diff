+package com.ovopark.edit.gl.command;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Stack;
+
+/**
+ * 鍛戒护鍘嗗彶鏍堢鐞嗗櫒
+ * 鏀寔鎾ら攢/閲嶅仛鍔熻兘
+ * 
+ * 璁捐妯″紡锛欳ommand Pattern + Memento Pattern
+ * 
+ * @author panruiqi
+ * @since 1.0.0
+ */
+public class CommandHistory {
+    private static final String TAG = "CommandHistory";
+    
+    /**
+     * 鎾ら攢鏍堬細淇濆瓨宸叉墽琛岀殑鍛戒护
+     */
+    private final Stack<ICommand> mUndoStack = new Stack<>();
+    
+    /**
+     * 閲嶅仛鏍堬細淇濆瓨宸叉挙閿€鐨勫懡浠?+     */
+    private final Stack<ICommand> mRedoStack = new Stack<>();
+    
+    /**
+     * 鍘嗗彶鏍堟渶澶уぇ灏忥紙闃叉鍐呭瓨婧㈠嚭锛?+     */
+    private int mMaxHistorySize = 50;
+    
+    /**
+     * 鎵ц鏂板懡浠?+     * 
+     * @param command 瑕佹墽琛岀殑鍛戒护
+     */
+    public void executeCommand(ICommand command) {
+        if (command == null) {
+            return;
+        }
+        
+        // 鎵ц鍛戒护
+        command.execute();
+        
+        // 娣诲姞鍒版挙閿€鏍?+        mUndoStack.push(command);
+        
+        // 鎵ц鏂板懡浠ゅ悗锛屾竻绌洪噸鍋氭爤
+        mRedoStack.clear();
+        
+        // 闄愬埗鍘嗗彶鏍堝ぇ灏?+        if (mUndoStack.size() > mMaxHistorySize) {
+            mUndoStack.remove(0);
+        }
+    }
+    
+    /**
+     * 鎾ら攢涓婁竴涓懡浠?+     * 
+     * @return 鏄惁鎾ら攢鎴愬姛
+     */
+    public boolean undo() {
+        if (!canUndo()) {
+            return false;
+        }
+        
+        ICommand command = mUndoStack.pop();
+        command.undo();
+        mRedoStack.push(command);
+        
+        return true;
+    }
+    
+    /**
+     * 閲嶅仛涓婁竴涓鎾ら攢鐨勫懡浠?+     * 
+     * @return 鏄惁閲嶅仛鎴愬姛
+     */
+    public boolean redo() {
+        if (!canRedo()) {
+            return false;
+        }
+        
+        ICommand command = mRedoStack.pop();
+        command.redo();
+        mUndoStack.push(command);
+        
+        return true;
+    }
+    
+    /**
+     * 鏄惁鍙互鎾ら攢
+     * 
+     * @return true 濡傛灉鎾ら攢鏍堜笉涓虹┖
+     */
+    public boolean canUndo() {
+        return !mUndoStack.isEmpty();
+    }
+    
+    /**
+     * 鏄惁鍙互閲嶅仛
+     * 
+     * @return true 濡傛灉閲嶅仛鏍堜笉涓虹┖
+     */
+    public boolean canRedo() {
+        return !mRedoStack.isEmpty();
+    }
+    
+    /**
+     * 鑾峰彇鎾ら攢鏍堝ぇ灏?+     * 
+     * @return 鍙挙閿€鐨勫懡浠ゆ暟閲?+     */
+    public int getUndoCount() {
+        return mUndoStack.size();
+    }
+    
+    /**
+     * 鑾峰彇閲嶅仛鏍堝ぇ灏?+     * 
+     * @return 鍙噸鍋氱殑鍛戒护鏁伴噺
+     */
+    public int getRedoCount() {
+        return mRedoStack.size();
+    }
+    
+    /**
+     * 娓呯┖鎵€鏈夊巻鍙茶褰?+     */
+    public void clear() {
+        mUndoStack.clear();
+        mRedoStack.clear();
+    }
+    
+    /**
+     * 璁剧疆鍘嗗彶鏍堟渶澶уぇ灏?+     * 
+     * @param maxSize 鏈€澶уぇ灏?+     */
+    public void setMaxHistorySize(int maxSize) {
+        this.mMaxHistorySize = Math.max(1, maxSize);
+    }
+    
+    /**
+     * 鑾峰彇鍘嗗彶璁板綍锛堢敤浜庤皟璇曪級
+     * 
+     * @return 鍛戒护鎻忚堪鍒楄〃
+     */
+    public List<String> getHistory() {
+        List<String> history = new ArrayList<>();
+        for (ICommand cmd : mUndoStack) {
+            history.add(cmd.getDescription());
+        }
+        return history;
+    }
+}
+
