+    
+    ToolType(String key, String displayName) {
+        this.key = key;
+        this.displayName = displayName;
+    }
+    
+    public String getKey() {
+        return key;
+    }
+    
+    public String getDisplayName() {
+        return displayName;
+    }
+    
+    /**
+     * 鏍规嵁key鑾峰彇宸ュ叿绫诲瀷
+     * 
+     * @param key 宸ュ叿key
+     * @return 瀵瑰簲鐨勫伐鍏风被鍨嬶紝濡傛灉娌℃壘鍒拌繑鍥瀗ull
+     */
+    public static ToolType fromKey(String key) {
+        for (ToolType type : values()) {
+            if (type.key.equals(key)) {
+                return type;
+            }
+        }
+        return null;
+    }
+    
+    /**
+     * 鍒ゆ柇鏄惁涓?OpenGL 宸ュ叿
+     * 
+     * @return true 濡傛灉鏄?OpenGL 宸ュ叿锛堢澶淬€佺煩褰€佸渾褰€佺洿绾跨瓑锛?+     */
+    public boolean isOpenGLTool() {
