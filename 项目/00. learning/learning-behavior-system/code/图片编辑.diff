+package com.ovopark.edit.gl;
+
+import android.graphics.Bitmap;
+import android.opengl.GLES20;
+import android.util.Log;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/**
+ * FBO (FrameBuffer Object) 绠＄悊鍣?+ * 璐熻矗绂诲睆娓叉煋鍜岄珮鏁堢殑鍍忕礌璇诲彇
+ * 
+ * @author panruiqi
+ * @since 1.0.0
+ */
+public class FBOManager {
+    
+    private static final String TAG = "FBOManager";
+    
+    /**
+     * FBO 灏佽绫?+     */
+    public static class FBO {
+        public int fboId = -1;
+        public int textureId = -1;
+        public int width;
+        public int height;
+        
+        public boolean isValid() {
+            return fboId != -1 && textureId != -1;
+        }
+        
+        @Override
+        public String toString() {
+            return "FBO{id=" + fboId + ", texture=" + textureId + 
+                    ", size=" + width + "x" + height + "}";
+        }
+    }
+    
+    /**
+     * 鍒涘缓 FBO
+     * 
+     * @param width FBO 瀹藉害锛堥€氬父鏄浘鐗囧師濮嬪搴︼級
+     * @param height FBO 楂樺害锛堥€氬父鏄浘鐗囧師濮嬮珮搴︼級
+     * @return FBO 瀵硅薄锛屽け璐ヨ繑鍥?null
+     */
+    public FBO createFBO(int width, int height) {
+        Log.d(TAG, "Creating FBO: " + width + "x" + height);
+        
+        if (width <= 0 || height <= 0) {
+            Log.e(TAG, "Invalid FBO size: " + width + "x" + height);
+            return null;
+        }
+        
+        FBO fbo = new FBO();
+        fbo.width = width;
+        fbo.height = height;
+        
+        try {
+            // 1. 鍒涘缓绾圭悊
+            int[] textures = new int[1];
+            GLES20.glGenTextures(1, textures, 0);
+            fbo.textureId = textures[0];
+            
+            if (fbo.textureId == 0) {
+                Log.e(TAG, "Failed to generate texture");
+                return null;
+            }
+            
