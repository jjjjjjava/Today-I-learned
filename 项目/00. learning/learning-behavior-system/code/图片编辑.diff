+    
+    /**
+     * 鎹曡幏褰撳墠娓叉煋缁撴灉锛堜紭鍖栫増锛氫粠 FBO 鐩存帴璇诲彇锛?+     * 娉ㄦ剰锛氭鏂规硶蹇呴』鍦?GL 绾跨▼涓皟鐢?+     * 
+     * @param callback 鎹曡幏鍥炶皟
+     */
+    public void captureResult(CaptureCallback callback) {
+        Log.d(TAG, "===== captureResult START =====");
+        
+        if (callback == null) {
+            Log.w(TAG, "captureResult: callback is null");
+            return;
+        }
+        
+        if (mRenderFBO == null || !mRenderFBO.isValid()) {
+            Log.e(TAG, "FBO not available");
+            callback.onError("FBO not available");
+            return;
+        }
+        
+        try {
+            long startTime = System.currentTimeMillis();
+            
+            // 鐩存帴浠?FBO 璇诲彇锛堜竴娆℃€у畬鎴愶紝宸茬粡鏄浘鐗囧師濮嬪昂瀵革級
+            Bitmap result = mFBOManager.readBitmapFromFBO(mRenderFBO);
+            
+            long duration = System.currentTimeMillis() - startTime;
+            
+            if (result != null) {
+                Log.d(TAG, "鉁?Captured from FBO in " + duration + "ms, size: " + 
+                        result.getWidth() + "x" + result.getHeight());
+                callback.onCapture(result);
+            } else {
+                Log.e(TAG, "Failed to read from FBO");
+                callback.onError("Failed to read from FBO");
+            }
+            
+        } catch (Exception e) {
+            Log.e(TAG, "Capture failed", e);
+            callback.onError(e.getMessage());
+        }
+        
+        Log.d(TAG, "===== captureResult END =====");
+    }
+    
+    /**
+     * 灏嗗綋鍓嶆墍鏈夊唴瀹瑰浐鍖栦负搴曢儴绾圭悊锛堜紭鍖栫増锛欸PU 鐩存帴鎷疯礉锛?+     * 鐢ㄤ簬鍦ㄥ伐鍏峰垏鎹㈡椂淇濈暀鎵€鏈夊凡缁樺埗鐨勫唴瀹?+     * 
+     * 娉ㄦ剰锛氭鏂规硶蹇呴』鍦?GL 绾跨▼涓皟鐢紝鍦ㄦ覆鏌撳畬鎴愬悗璋冪敤
+     */
+    public void commitToTexture() {
+        Log.d(TAG, "");
+        Log.d(TAG, "##################################################");
+        Log.d(TAG, "========== commitToTexture START ==========");
+        Log.d(TAG, "##################################################");
+        
+        if (mRenderFBO == null || !mRenderFBO.isValid()) {
+            Log.w(TAG, "FBO not available, cannot commit");
+            return;
+        }
+        
+        Log.d(TAG, "Source: FBO (ID=" + mRenderFBO.fboId + ", Texture=" + mRenderFBO.textureId + ", Size=" + mRenderFBO.width + "x" + mRenderFBO.height + ")");
+        Log.d(TAG, "Target: Base Texture (ID=" + mBaseTextureId + ", Size=" + mImageWidth + "x" + mImageHeight + ")");
+        
+        try {
+            long startTime = System.currentTimeMillis();
+            
+            // 缁戝畾 FBO 璇诲彇鍍忕礌
+            mFBOManager.bindFBO(mRenderFBO);
+            Log.d(TAG, "FBO bound for reading");
+            
+            // 璇诲彇鍍忕礌鍒?ByteBuffer
+            Log.d(TAG, "Reading pixels from FBO...");
+            int pixelCount = mImageWidth * mImageHeight;
+            ByteBuffer pixelBuffer = ByteBuffer.allocateDirect(pixelCount * 4);
+            pixelBuffer.order(ByteOrder.nativeOrder());
+            
+            GLES20.glReadPixels(
+                0, 0,                           // 璧峰浣嶇疆
+                mImageWidth, mImageHeight,      // 灏哄
+                GLES20.GL_RGBA,                 // 鏍煎紡
+                GLES20.GL_UNSIGNED_BYTE,        // 绫诲瀷
+                pixelBuffer
+            );
+            
+            int readError = GLES20.glGetError();
+            if (readError != GLES20.GL_NO_ERROR) {
+                Log.e(TAG, "鉂?glReadPixels error: " + readError);
+                mFBOManager.unbindFBO(mSurfaceWidth, mSurfaceHeight);
+                return;
+            }
+            Log.d(TAG, "鉁?Pixels read successfully (" + (pixelCount * 4) + " bytes)");
+            
+            // Y 杞寸炕杞紙FBO 鏄?OpenGL 鍧愭爣绯伙紝绾圭悊闇€瑕?Bitmap 鍧愭爣绯伙級
+            Log.d(TAG, "Flipping Y-axis to match texture orientation...");
+            ByteBuffer flippedBuffer = ByteBuffer.allocateDirect(pixelCount * 4);
+            flippedBuffer.order(ByteOrder.nativeOrder());
+            
+            int rowBytes = mImageWidth * 4;
+            byte[] rowData = new byte[rowBytes];
+            
+            for (int y = 0; y < mImageHeight; y++) {
+                // 浠庡簳閮ㄨ鍙?+                pixelBuffer.position((mImageHeight - 1 - y) * rowBytes);
+                pixelBuffer.get(rowData, 0, rowBytes);
+                
+                // 鍐欏叆鍒伴《閮?+                flippedBuffer.position(y * rowBytes);
+                flippedBuffer.put(rowData, 0, rowBytes);
+            }
+            flippedBuffer.position(0);
+            Log.d(TAG, "鉁?Y-axis flipped");
+            
+            // 瑙ｇ粦 FBO
+            mFBOManager.unbindFBO(mSurfaceWidth, mSurfaceHeight);
+            
+            // 涓婁紶鍒板熀纭€绾圭悊
+            Log.d(TAG, "Uploading flipped pixels to base texture...");
+            GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, mBaseTextureId);
+            
+            GLES20.glTexSubImage2D(
+                GLES20.GL_TEXTURE_2D,
+                0,                          // mipmap level
+                0, 0,                       // 鐩爣浣嶇疆
+                mImageWidth, mImageHeight,  // 灏哄
+                GLES20.GL_RGBA,
+                GLES20.GL_UNSIGNED_BYTE,
+                flippedBuffer
+            );
+            
+            int uploadError = GLES20.glGetError();
+            if (uploadError != GLES20.GL_NO_ERROR) {
+                Log.e(TAG, "鉂?glTexSubImage2D error: " + uploadError);
+            } else {
+                Log.d(TAG, "鉁?Texture updated successfully");
+            }
+            
+            GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, 0);
+            Log.d(TAG, "Texture unbound");
+            
+            // 鏇存柊 Bitmap 鍓湰锛圙L 鐜閲嶅缓鏃堕渶瑕侊級
+            Log.d(TAG, "Updating Bitmap copy for GL context recreation...");
+            if (mBaseBitmap != null) {
+                Log.d(TAG, "  Recycling old bitmap: " + mBaseBitmap.getWidth() + "x" + mBaseBitmap.getHeight());
+                mBaseBitmap.recycle();
+            }
+            mBaseBitmap = mFBOManager.readBitmapFromFBO(mRenderFBO);
+            Log.d(TAG, "  New bitmap created: " + (mBaseBitmap != null ? mBaseBitmap.getWidth() + "x" + mBaseBitmap.getHeight() : "null"));
+            
+            long duration = System.currentTimeMillis() - startTime;
+            Log.d(TAG, "鉁?Committed to texture in " + duration + "ms (GPU direct copy)");
+            
+        } catch (Exception e) {
+            Log.e(TAG, "鉂?Failed to commit to texture", e);
+        }
+        
+        Log.d(TAG, "========== commitToTexture END ==========");
+        Log.d(TAG, "");
+    }
+}
