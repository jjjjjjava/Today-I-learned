+    public void unbindFBO(int surfaceWidth, int surfaceHeight) {
+        GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, 0);
+        GLES20.glViewport(0, 0, surfaceWidth, surfaceHeight);
+    }
+    
+    /**
+     * 浠?FBO 璇诲彇 Bitmap锛堜紭鍖栫増锛屼竴娆℃€у畬鎴愶級
+     * 鐩存帴璇诲彇鍥剧墖鍘熷灏哄锛屾棤闇€瑁佸壀鍜岀缉鏀?+     * 
+     * @param fbo FBO 瀵硅薄
+     * @return 璇诲彇鐨?Bitmap锛屽け璐ヨ繑鍥?null
+     */
+    public Bitmap readBitmapFromFBO(FBO fbo) {
+        if (fbo == null || !fbo.isValid()) {
+            Log.e(TAG, "Cannot read from invalid FBO");
+            return null;
+        }
+        
+        long startTime = System.currentTimeMillis();
+        Log.d(TAG, "Reading bitmap from FBO: " + fbo.width + "x" + fbo.height);
+        
+        try {
+            // 缁戝畾 FBO
+            GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, fbo.fboId);
+            
+            // 鍒嗛厤缂撳啿鍖?+            int width = fbo.width;
+            int height = fbo.height;
+            ByteBuffer buffer = ByteBuffer.allocateDirect(width * height * 4);
+            buffer.order(ByteOrder.nativeOrder());
+            
+            // 璇诲彇鍍忕礌
+            GLES20.glReadPixels(0, 0, width, height, 
+                    GLES20.GL_RGBA, GLES20.GL_UNSIGNED_BYTE, buffer);
+            
+            // 妫€鏌ラ敊璇?+            int error = GLES20.glGetError();
+            if (error != GLES20.GL_NO_ERROR) {
+                Log.e(TAG, "glReadPixels error: " + error);
+                GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, 0);
+                return null;
+            }
+            
+            // Y杞寸炕杞紙OpenGL 鍧愭爣绯?Y 杞翠笌 Android 鐩稿弽锛?+            buffer = flipBufferVertically(buffer, width, height);
+            
+            // 鍒涘缓 Bitmap锛堝彧鍒涘缓涓€娆★級
+            Bitmap bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
+            buffer.rewind();
+            bitmap.copyPixelsFromBuffer(buffer);
+            
+            // 瑙ｇ粦
+            GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, 0);
+            
+            long duration = System.currentTimeMillis() - startTime;
+            Log.d(TAG, "鉁?Bitmap read from FBO in " + duration + "ms");
+            
+            return bitmap;
+            
+        } catch (Exception e) {
+            Log.e(TAG, "Exception reading bitmap from FBO", e);
+            GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, 0);
+            return null;
+        }
+    }
+    
+    /**
+     * 鍦?ByteBuffer 涓炕杞?Y 杞达紙閬垮厤鍒涘缓涓棿 Bitmap锛?+     * 
+     * @param src 婧愮紦鍐插尯
+     * @param width 鍥剧墖瀹藉害
+     * @param height 鍥剧墖楂樺害
+     * @return 缈昏浆鍚庣殑缂撳啿鍖?+     */
+    private ByteBuffer flipBufferVertically(ByteBuffer src, int width, int height) {
+        ByteBuffer dst = ByteBuffer.allocateDirect(width * height * 4);
+        dst.order(ByteOrder.nativeOrder());
+        
+        int rowBytes = width * 4;
+        byte[] rowBuffer = new byte[rowBytes];
+        
+        src.rewind();
+        for (int y = 0; y < height; y++) {
+            // 浠庡簳閮ㄨ鍙栬
+            src.position((height - 1 - y) * rowBytes);
+            src.get(rowBuffer, 0, rowBytes);
+            
+            // 鍐欏叆椤堕儴
+            dst.put(rowBuffer);
+        }
+        
+        dst.rewind();
+        return dst;
+    }
+    
+    /**
+     * 閿€姣?FBO
+     * 
+     * @param fbo FBO 瀵硅薄
+     */
+    public void deleteFBO(FBO fbo) {
+        if (fbo == null) {
+            return;
+        }
+        
+        if (fbo.textureId != -1) {
+            int[] textures = {fbo.textureId};
+            GLES20.glDeleteTextures(1, textures, 0);
+            Log.d(TAG, "Texture deleted: " + fbo.textureId);
+            fbo.textureId = -1;
+        }
+        
+        if (fbo.fboId != -1) {
+            int[] fbos = {fbo.fboId};
+            GLES20.glDeleteFramebuffers(1, fbos, 0);
+            Log.d(TAG, "FBO deleted: " + fbo.fboId);
+            fbo.fboId = -1;
+        }
+    }
+}
