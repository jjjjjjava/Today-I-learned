diff --git a/lib_edit/src/main/java/com/ovopark/edit/gl/utils/ShaderUtils.java b/lib_edit/src/main/java/com/ovopark/edit/gl/utils/ShaderUtils.java
new file mode 100644
index 0000000000..c0251b57fd
--- /dev/null
+++ b/lib_edit/src/main/java/com/ovopark/edit/gl/utils/ShaderUtils.java
@@ -0,0 +1,181 @@
+package com.ovopark.edit.gl.utils;
+
+import android.content.Context;
+import android.opengl.GLES20;
+import android.util.Log;
+
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+
+/**
+ * Shader 宸ュ叿绫?+ * 璐熻矗鍔犺浇銆佺紪璇戝拰閾炬帴 OpenGL Shader
+ * 
+ * @author panruiqi
+ * @since 1.0.0
+ */
+public class ShaderUtils {
+    
+    private static final String TAG = "ShaderUtils";
+    
+    /**
+     * 浠庤祫婧愭枃浠惰鍙?Shader 浠ｇ爜
+     * 
+     * @param context 涓婁笅鏂?+     * @param resourceId 璧勬簮ID锛圧.raw.xxx锛?+     * @return Shader 浠ｇ爜瀛楃涓?+     */
+    public static String readShaderFromRaw(Context context, int resourceId) {
+        StringBuilder shaderCode = new StringBuilder();
+        InputStream inputStream = null;
+        BufferedReader reader = null;
+        
+        try {
+            inputStream = context.getResources().openRawResource(resourceId);
+            reader = new BufferedReader(new InputStreamReader(inputStream));
+            
+            String line;
+            while ((line = reader.readLine()) != null) {
+                shaderCode.append(line).append('\n');
+            }
+        } catch (IOException e) {
+            Log.e(TAG, "Error reading shader from resource " + resourceId, e);
+        } finally {
+            try {
+                if (reader != null) reader.close();
+                if (inputStream != null) inputStream.close();
+            } catch (IOException e) {
+                Log.e(TAG, "Error closing stream", e);
+            }
+        }
+        
+        return shaderCode.toString();
+    }
+    
+    /**
+     * 缂栬瘧 Shader
+     * 
+     * @param shaderType Shader 绫诲瀷锛圙LES20.GL_VERTEX_SHADER 鎴?GLES20.GL_FRAGMENT_SHADER锛?+     * @param shaderCode Shader 浠ｇ爜
+     * @return Shader ID锛屽け璐ヨ繑鍥?0
+     */
+    public static int compileShader(int shaderType, String shaderCode) {
+        // 鍒涘缓 Shader 瀵硅薄
+        int shader = GLES20.glCreateShader(shaderType);
+        if (shader == 0) {
+            Log.e(TAG, "Error creating shader type: " + shaderType);
+            return 0;
+        }
+        
+        // 鍔犺浇 Shader 浠ｇ爜
+        GLES20.glShaderSource(shader, shaderCode);
+        
+        // 缂栬瘧 Shader
+        GLES20.glCompileShader(shader);
+        
+        // 妫€鏌ョ紪璇戠姸鎬?+        int[] compiled = new int[1];
+        GLES20.glGetShaderiv(shader, GLES20.GL_COMPILE_STATUS, compiled, 0);
+        
+        if (compiled[0] == 0) {
+            String error = GLES20.glGetShaderInfoLog(shader);
+            Log.e(TAG, "Error compiling shader: " + error);
+            Log.e(TAG, "Shader code: \n" + shaderCode);
+            GLES20.glDeleteShader(shader);
+            return 0;
+        }
+        
+        return shader;
+    }
+    
+    /**
+     * 閾炬帴 Shader 绋嬪簭
+     * 
+     * @param vertexShader 椤剁偣鐫€鑹插櫒 ID
+     * @param fragmentShader 鐗囨鐫€鑹插櫒 ID
+     * @return 绋嬪簭 ID锛屽け璐ヨ繑鍥?0
+     */
+    public static int linkProgram(int vertexShader, int fragmentShader) {
+        // 鍒涘缓绋嬪簭瀵硅薄
+        int program = GLES20.glCreateProgram();
+        if (program == 0) {
+            Log.e(TAG, "Error creating program");
+            return 0;
+        }
+        
+        // 闄勫姞 Shader
+        GLES20.glAttachShader(program, vertexShader);
+        GLES20.glAttachShader(program, fragmentShader);
+        
+        // 閾炬帴绋嬪簭
+        GLES20.glLinkProgram(program);
+        
+        // 妫€鏌ラ摼鎺ョ姸鎬?+        int[] linked = new int[1];
+        GLES20.glGetProgramiv(program, GLES20.GL_LINK_STATUS, linked, 0);
+        
+        if (linked[0] == 0) {
+            String error = GLES20.glGetProgramInfoLog(program);
+            Log.e(TAG, "Error linking program: " + error);
+            GLES20.glDeleteProgram(program);
+            return 0;
+        }
+        
+        return program;
+    }
+    
+    /**
+     * 鍒涘缓瀹屾暣鐨?Shader 绋嬪簭锛堢紪璇?+ 閾炬帴锛?+     * 
+     * @param context 涓婁笅鏂?+     * @param vertexShaderResId 椤剁偣鐫€鑹插櫒璧勬簮 ID
+     * @param fragmentShaderResId 鐗囨鐫€鑹插櫒璧勬簮 ID
+     * @return 绋嬪簭 ID锛屽け璐ヨ繑鍥?0
+     */
+    public static int createProgram(Context context, int vertexShaderResId, int fragmentShaderResId) {
+        // 璇诲彇 Shader 浠ｇ爜
+        String vertexShaderCode = readShaderFromRaw(context, vertexShaderResId);
+        String fragmentShaderCode = readShaderFromRaw(context, fragmentShaderResId);
+        
+        // 缂栬瘧 Shader
+        int vertexShader = compileShader(GLES20.GL_VERTEX_SHADER, vertexShaderCode);
+        if (vertexShader == 0) {
+            return 0;
+        }
+        
+        int fragmentShader = compileShader(GLES20.GL_FRAGMENT_SHADER, fragmentShaderCode);
+        if (fragmentShader == 0) {
+            GLES20.glDeleteShader(vertexShader);
+            return 0;
+        }
+        
+        // 閾炬帴绋嬪簭
+        int program = linkProgram(vertexShader, fragmentShader);
+        
+        // 鍒犻櫎 Shader 瀵硅薄锛堝凡閾炬帴鍒扮▼搴忎腑锛屼笉鍐嶉渶瑕侊級
+        GLES20.glDeleteShader(vertexShader);
+        GLES20.glDeleteShader(fragmentShader);
+        
+        if (program != 0) {
+            Log.d(TAG, "Shader program created successfully: " + program);
+        }
+        
+        return program;
+    }
+    
+    /**
+     * 楠岃瘉 OpenGL 閿欒
+     * 
+     * @param tag 鏃ュ織鏍囩
+     * @param operation 鎿嶄綔鍚嶇О
+     */
+    public static void checkGLError(String tag, String operation) {
+        int error;
+        while ((error = GLES20.glGetError()) != GLES20.GL_NO_ERROR) {
+            Log.e(tag, operation + ": glError " + error);
+        }
+    }
+}
+
