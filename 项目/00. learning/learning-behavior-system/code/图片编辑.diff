diff --git a/lib_edit/src/main/java/com/ovopark/edit/gl/tool/RectangleTool.java b/lib_edit/src/main/java/com/ovopark/edit/gl/tool/RectangleTool.java
new file mode 100644
index 0000000000..0a51ed7646
--- /dev/null
+++ b/lib_edit/src/main/java/com/ovopark/edit/gl/tool/RectangleTool.java
@@ -0,0 +1,203 @@
+package com.ovopark.edit.gl.tool;
+
+import android.opengl.GLES20;
+import android.util.Log;
+
+import com.ovopark.edit.gl.ShaderManager;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.FloatBuffer;
+
+/**
+ * 鐭╁舰缁樺埗宸ュ叿
+ * 浣跨敤 OpenGL 缁樺埗绌哄績鐭╁舰锛?鏉¤竟锛?+ * 
+ * @author panruiqi
+ * @since 1.0.0
+ */
+public class RectangleTool extends BaseDrawingTool {
+    
+    private static final String TAG = "RectangleTool";
+    
+    private final ShaderManager mShaderManager;
+    
+    /**
+     * Shader 鍙ユ焺
+     */
+    private int mPositionHandle = -1;
+    private int mColorHandle = -1;
+    private int mMVPMatrixHandle = -1;
+    
+    public RectangleTool(ShaderManager shaderManager) {
+        this.mShaderManager = shaderManager;
+    }
+    
+    @Override
+    public ToolType getToolType() {
+        return ToolType.RECTANGLE;
+    }
+    
+    @Override
+    public void render(float[] mvpMatrix) {
+        if (mShaderManager == null) {
+            Log.e(TAG, "ShaderManager is null");
+            return;
+        }
+        
+        // 浣跨敤褰㈢姸 Shader
+        if (!mShaderManager.useProgram(ShaderManager.ShaderType.SHAPE)) {
+            Log.e(TAG, "Failed to use shape shader");
+            return;
+        }
+        
+        // 鑾峰彇 Shader 鍙ユ焺
+        int program = mShaderManager.getProgram(ShaderManager.ShaderType.SHAPE);
+        mPositionHandle = GLES20.glGetAttribLocation(program, "aPosition");
+        mColorHandle = GLES20.glGetUniformLocation(program, "uColor");
+        mMVPMatrixHandle = GLES20.glGetUniformLocation(program, "uMVPMatrix");
+        
+        // 娓叉煋鎵€鏈夊凡瀹屾垚鐨勭煩褰?+        for (Shape shape : mShapeList) {
+            renderRectangle(shape, mvpMatrix);
+        }
+        
+        // 娓叉煋褰撳墠姝ｅ湪缁樺埗鐨勭煩褰?+        if (mIsDrawing && mCurrentShape != null) {
+            renderRectangle(mCurrentShape, mvpMatrix);
+        }
+    }
+    
+    /**
+     * 娓叉煋鍗曚釜鐭╁舰
+     * 
+     * @param shape 鐭╁舰褰㈢姸鏁版嵁
+     * @param mvpMatrix MVP 鐭╅樀
+     */
+    private void renderRectangle(Shape shape, float[] mvpMatrix) {
+        if (shape == null) {
+            return;
+        }
+        
+        // 鐢熸垚鐭╁舰椤剁偣
+        float[] vertices = generateVertices(shape);
+        if (vertices == null || vertices.length == 0) {
+            return;
+        }
+        
+        // 鍒涘缓椤剁偣缂撳啿
+        FloatBuffer vertexBuffer = ByteBuffer.allocateDirect(vertices.length * 4)
+                .order(ByteOrder.nativeOrder())
+                .asFloatBuffer()
+                .put(vertices);
+        vertexBuffer.position(0);
+        
+        // 鍚敤椤剁偣鏁扮粍
+        GLES20.glEnableVertexAttribArray(mPositionHandle);
+        
+        // 璁剧疆椤剁偣鏁版嵁
+        GLES20.glVertexAttribPointer(
+                mPositionHandle,
+                2,              // 姣忎釜椤剁偣 2 涓潗鏍?(x, y)
+                GLES20.GL_FLOAT,
+                false,
+                0,
+                vertexBuffer
+        );
+        
+        // 璁剧疆棰滆壊
+        GLES20.glUniform4fv(mColorHandle, 1, shape.color, 0);
+        
+        // 璁剧疆 MVP 鐭╅樀
+        GLES20.glUniformMatrix4fv(mMVPMatrixHandle, 1, false, mvpMatrix, 0);
+        
+        // 缁樺埗鐭╁舰锛堜笁瑙掑舰锛?+        GLES20.glDrawArrays(GLES20.GL_TRIANGLES, 0, vertices.length / 2);
+        
+        // 绂佺敤椤剁偣鏁扮粍
+        GLES20.glDisableVertexAttribArray(mPositionHandle);
+    }
+    
+    @Override
+    protected float[] generateVertices(Shape shape) {
+        if (shape == null) {
+            return new float[0];
+        }
+        
+        float left = Math.min(shape.startX, shape.endX);
+        float right = Math.max(shape.startX, shape.endX);
+        float top = Math.max(shape.startY, shape.endY);
+        float bottom = Math.min(shape.startY, shape.endY);
+        
+        float width = shape.strokeWidth;
+        
+        // 鏍规嵁瀹介珮姣旇皟鏁寸嚎瀹斤紝浣垮洓鏉¤竟鍦ㄥ睆骞曚笂鐪嬭捣鏉ヤ竴鏍风矖
+        // 姘村钩鏂瑰悜鐨勭嚎瀹斤紙涓婁笅杈癸級
+        float halfWidthY = (width * mAspectRatio) / 2.0f;
+        // 鍨傜洿鏂瑰悜鐨勭嚎瀹斤紙宸﹀彸杈癸級
+        float halfWidthX = width / 2.0f;
+        
+        // 鐭╁舰澶皬锛屼笉缁樺埗
+        if (Math.abs(right - left) < 0.001f || Math.abs(top - bottom) < 0.001f) {
+            return new float[0];
+        }
+        
+        // 璁＄畻鐭╁舰4鏉¤竟鐨勯《鐐癸紙姣忔潯杈圭敱2涓笁瑙掑舰缁勬垚锛?+        
+        // 椤惰竟锛堜笂杈癸級 - 浣跨敤璋冩暣鍚庣殑Y鏂瑰悜绾垮
+        float topOuterY = top + halfWidthY;
+        float topInnerY = top - halfWidthY;
+        
+        // 搴曡竟锛堜笅杈癸級 - 浣跨敤璋冩暣鍚庣殑Y鏂瑰悜绾垮
+        float bottomOuterY = bottom - halfWidthY;
+        float bottomInnerY = bottom + halfWidthY;
+        
+        // 宸﹁竟 - 浣跨敤X鏂瑰悜绾垮
+        float leftOuterX = left - halfWidthX;
+        float leftInnerX = left + halfWidthX;
+        
+        // 鍙宠竟 - 浣跨敤X鏂瑰悜绾垮
+        float rightOuterX = right + halfWidthX;
+        float rightInnerX = right - halfWidthX;
+        
+        // 杩斿洖椤剁偣鏁扮粍锛?涓笁瑙掑舰缁勬垚4鏉¤竟锛?+        return new float[]{
+                // 椤惰竟锛?涓笁瑙掑舰锛?+                leftOuterX, topOuterY,      // 澶栧乏涓?+                leftOuterX, topInnerY,      // 鍐呭乏涓?+                rightOuterX, topOuterY,     // 澶栧彸涓?+                
+                leftOuterX, topInnerY,      // 鍐呭乏涓?+                rightOuterX, topOuterY,     // 澶栧彸涓?+                rightOuterX, topInnerY,     // 鍐呭彸涓?+                
+                // 搴曡竟锛?涓笁瑙掑舰锛?+                leftOuterX, bottomOuterY,   // 澶栧乏涓?+                leftOuterX, bottomInnerY,   // 鍐呭乏涓?+                rightOuterX, bottomOuterY,  // 澶栧彸涓?+                
+                leftOuterX, bottomInnerY,   // 鍐呭乏涓?+                rightOuterX, bottomOuterY,  // 澶栧彸涓?+                rightOuterX, bottomInnerY,  // 鍐呭彸涓?+                
+                // 宸﹁竟锛?涓笁瑙掑舰锛?+                leftOuterX, bottomInnerY,   // 澶栧乏涓?+                leftInnerX, bottomInnerY,   // 鍐呭乏涓?+                leftOuterX, topInnerY,      // 澶栧乏涓?+                
+                leftInnerX, bottomInnerY,   // 鍐呭乏涓?+                leftOuterX, topInnerY,      // 澶栧乏涓?+                leftInnerX, topInnerY,      // 鍐呭乏涓?+                
+                // 鍙宠竟锛?涓笁瑙掑舰锛?+                rightInnerX, bottomInnerY,  // 鍐呭彸涓?+                rightOuterX, bottomInnerY,  // 澶栧彸涓?+                rightInnerX, topInnerY,     // 鍐呭彸涓?+                
+                rightOuterX, bottomInnerY,  // 澶栧彸涓?+                rightInnerX, topInnerY,     // 鍐呭彸涓?+                rightOuterX, topInnerY      // 澶栧彸涓?+        };
+    }
+}
+
