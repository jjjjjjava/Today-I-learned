+    public void setBaseBitmap(Bitmap bitmap) {
+        Log.d(TAG, "setBaseBitmap called");
+        
+        // 妫€鏌itmap鏄惁鏈夋晥
+        if (bitmap != null && bitmap.isRecycled()) {
+            Log.e(TAG, "Cannot set recycled bitmap");
+            return;
+        }
+        
+        Log.d(TAG, "Input bitmap: " + (bitmap != null ? 
+                (bitmap.getWidth() + "x" + bitmap.getHeight()) : "null"));
+        
+        // 閲婃斁鏃у壇鏈?+        if (mBaseBitmap != null && !mBaseBitmap.isRecycled()) {
+            mBaseBitmap.recycle();
+        }
+        mBaseBitmap = null;
+        
+        // 鍒涘缓鍓湰锛堥槻姝㈠閮ㄥ洖鏀跺鑷村穿婧冿級
+        if (bitmap != null) {
+            try {
+                Bitmap.Config config = bitmap.getConfig();
+                if (config == null) {
+                    config = Bitmap.Config.ARGB_8888;
+                    Log.w(TAG, "Bitmap config is null, using ARGB_8888");
+                }
+                
+                mBaseBitmap = bitmap.copy(config, false);
+                Log.d(TAG, "Bitmap copied: " + mBaseBitmap.getWidth() + "x" + mBaseBitmap.getHeight());
+            } catch (OutOfMemoryError e) {
+                Log.e(TAG, "OOM when copying bitmap", e);
+                mBaseBitmap = null;
+                return;
+            }
+            
+            // 鏇存柊鍥剧墖灏哄
+            mImageWidth = mBaseBitmap.getWidth();
+            mImageHeight = mBaseBitmap.getHeight();
+            
+            // Surface宸插瓨鍦ㄥ垯鏍囪闇€瑕侀噸鏂板姞杞界汗鐞?+            if (mSurfaceWidth > 0 && mSurfaceHeight > 0) {
+                mNeedReloadTexture = true;
+                Log.d(TAG, "Surface exists, will reload texture on next frame");
+            }
+        } else {
+            mImageWidth = 0;
+            mImageHeight = 0;
+        }
+    }
