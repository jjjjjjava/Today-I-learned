+    /**
+     * 鍔犺浇绾圭悊
+     * 
+     * @param bitmap 浣嶅浘
+     * @return 绾圭悊 ID锛屽鏋滃け璐ヨ繑鍥?-1
+     */
+    private int loadTexture(Bitmap bitmap) {
+        Log.d(TAG, "---- loadTexture START ----");
+        
+        if (bitmap == null) {
+            Log.e(TAG, "鉂?loadTexture: bitmap is null");
+            return -1;
+        }
+        
+        Log.d(TAG, "Input bitmap: " + bitmap.getWidth() + "x" + bitmap.getHeight() + 
+                " [" + bitmap.getConfig() + "]");
+        
+        int[] textures = new int[1];
+        GLES20.glGenTextures(1, textures, 0);
+        
+        if (textures[0] == 0) {
+            Log.e(TAG, "鉂?Failed to generate texture");
+            return -1;
+        }
+        
+        Log.d(TAG, "Generated texture ID: " + textures[0]);
+        
+        GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, textures[0]);
+        Log.d(TAG, "Texture bound");
+        
+        // 璁剧疆绾圭悊鍙傛暟
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_MIN_FILTER, GLES20.GL_LINEAR);
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_MAG_FILTER, GLES20.GL_LINEAR);
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_WRAP_S, GLES20.GL_CLAMP_TO_EDGE);
+        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_WRAP_T, GLES20.GL_CLAMP_TO_EDGE);
+        Log.d(TAG, "Texture parameters set (LINEAR filter, CLAMP_TO_EDGE wrap)");
+        
+        // 鍔犺浇浣嶅浘鍒扮汗鐞?+        long startTime = System.currentTimeMillis();
+        GLUtils.texImage2D(GLES20.GL_TEXTURE_2D, 0, bitmap, 0);
+        long uploadTime = System.currentTimeMillis() - startTime;
+        Log.d(TAG, "Bitmap uploaded to GPU in " + uploadTime + "ms");
+        
+        // 妫€鏌ラ敊璇?+        int error = GLES20.glGetError();
+        if (error != GLES20.GL_NO_ERROR) {
+            Log.e(TAG, "鉂?OpenGL error after texImage2D: " + error);
+        }
+        
+        GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, 0);
+        Log.d(TAG, "Texture unbound");
+        
+        Log.d(TAG, "鉁?Texture loaded successfully: ID=" + textures[0] + 
+                ", size=" + bitmap.getWidth() + "x" + bitmap.getHeight());
+        Log.d(TAG, "---- loadTexture END ----");
+        
+        return textures[0];
+    }
