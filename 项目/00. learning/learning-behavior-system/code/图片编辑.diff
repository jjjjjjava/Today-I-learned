+    /**
+     * 璁＄畻 bitmap 鍐呭鎸囩汗锛堢敤浜庤皟璇曪級
+     * 閲囨牱 bitmap 鐨勯儴鍒嗗儚绱犳潵鐢熸垚涓€涓畝鍗曠殑鍝堝笇鍊?+     * 
+     * @param bitmap 瑕佽绠楁寚绾圭殑 bitmap
+     * @return 鎸囩汗瀛楃涓?+     */
+    private String calculateBitmapFingerprint(Bitmap bitmap) {
+        if (bitmap == null || bitmap.getWidth() == 0 || bitmap.getHeight() == 0) {
+            return "EMPTY";
+        }
+        
+        try {
+            int width = bitmap.getWidth();
+            int height = bitmap.getHeight();
+            
+            // 閲囨牱 9 涓偣锛?x3 缃戞牸锛?+            int[] samplePoints = new int[9];
+            int index = 0;
+            
+            for (int y = 0; y < 3; y++) {
+                for (int x = 0; x < 3; x++) {
+                    int px = (width * x) / 3 + width / 6;  // 閲囨牱鐐瑰湪姣忎釜鏍煎瓙鐨勪腑蹇?+                    int py = (height * y) / 3 + height / 6;
+                    
+                    // 纭繚涓嶈秺鐣?+                    px = Math.min(px, width - 1);
+                    py = Math.min(py, height - 1);
+                    
+                    samplePoints[index++] = bitmap.getPixel(px, py);
+                }
+            }
+            
+            // 璁＄畻绠€鍗曞搱甯?+            long hash = 0;
+            for (int pixel : samplePoints) {
+                hash = hash * 31 + pixel;
+            }
+            
+            // 杩斿洖16杩涘埗瀛楃涓?+            return String.format("%016X", hash);
+            
+        } catch (Exception e) {
+            return "ERROR:" + e.getMessage();
+        }
+    }
