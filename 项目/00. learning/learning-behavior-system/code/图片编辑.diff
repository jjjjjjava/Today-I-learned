+     * 閲嶇疆宸ュ叿锛堟竻绌烘墍鏈夌粯鍒跺唴瀹癸級
+     */
+    void reset();
+    
+    /**
+     * 鑾峰彇鍛戒护鍘嗗彶瀵硅薄
+     * 
+     * @return 鍛戒护鍘嗗彶瀵硅薄
+     */
+    CommandHistory getCommandHistory();
