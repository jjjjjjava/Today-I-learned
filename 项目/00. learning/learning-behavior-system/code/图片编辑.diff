+package com.ovopark.edit.gl.tool;
+
+/**
+ * 褰㈢姸鏁版嵁绫?+ * 淇濆瓨缁樺埗褰㈢姸鐨勬墍鏈夊睘鎬?+ * 
+ * @author panruiqi
+ * @since 1.0.0
+ */
+public class Shape {
+    /**
+     * 璧风偣 X 鍧愭爣锛圤penGL 鍧愭爣绯伙細-1.0 ~ 1.0锛?+     */
+    public float startX;
+    
+    /**
+     * 璧风偣 Y 鍧愭爣锛圤penGL 鍧愭爣绯伙細-1.0 ~ 1.0锛?+     */
+    public float startY;
+    
+    /**
+     * 缁堢偣 X 鍧愭爣锛圤penGL 鍧愭爣绯伙細-1.0 ~ 1.0锛?+     */
+    public float endX;
+    
+    /**
+     * 缁堢偣 Y 鍧愭爣锛圤penGL 鍧愭爣绯伙細-1.0 ~ 1.0锛?+     */
+    public float endY;
+    
+    /**
+     * 棰滆壊锛圧GBA锛岃寖鍥?0.0 ~ 1.0锛?+     */
+    public float[] color = new float[4];
+    
+    /**
+     * 绾挎潯绮楃粏锛圤penGL 鍧愭爣绯诲崟浣嶏級
+     */
+    public float strokeWidth;
+    
+    /**
+     * 鍒涘缓鏃堕棿鎴筹紙鐢ㄤ簬鎺掑簭鍜岃皟璇曪級
+     */
+    public long timestamp;
+    
+    /**
+     * 榛樿鏋勯€犲嚱鏁?+     */
+    public Shape() {
+        this.color[0] = 1.0f;  // R
+        this.color[1] = 0.0f;  // G
+        this.color[2] = 0.0f;  // B
+        this.color[3] = 1.0f;  // A
+    }
+    
+    /**
+     * 瀹屾暣鏋勯€犲嚱鏁?+     * 
+     * @param startX 璧风偣X
+     * @param startY 璧风偣Y
+     * @param endX 缁堢偣X
+     * @param endY 缁堢偣Y
+     * @param color 棰滆壊鏁扮粍锛圧GBA锛?+     * @param strokeWidth 绾垮
+     */
+    public Shape(float startX, float startY, float endX, float endY, 
+                 float[] color, float strokeWidth) {
+        this.startX = startX;
+        this.startY = startY;
+        this.endX = endX;
+        this.endY = endY;
+        
+        // 娣辨嫹璐濋鑹叉暟缁?+        if (color != null && color.length >= 4) {
+            System.arraycopy(color, 0, this.color, 0, 4);
+        }
+        
+        this.strokeWidth = strokeWidth;
+        this.timestamp = System.currentTimeMillis();
+    }
+    
+    /**
+     * 鎷疯礉鏋勯€犲嚱鏁?+     * 
+     * @param other 瑕佹嫹璐濈殑褰㈢姸
+     */
+    public Shape(Shape other) {
+        if (other != null) {
+            this.startX = other.startX;
+            this.startY = other.startY;
+            this.endX = other.endX;
+            this.endY = other.endY;
+            System.arraycopy(other.color, 0, this.color, 0, 4);
+            this.strokeWidth = other.strokeWidth;
+            this.timestamp = other.timestamp;
+        }
+    }
+    
+    @Override
+    public String toString() {
+        return "Shape{" +
+                "start=(" + startX + ", " + startY + "), " +
+                "end=(" + endX + ", " + endY + "), " +
+                "strokeWidth=" + strokeWidth +
+                '}';
+    }
+}
+
