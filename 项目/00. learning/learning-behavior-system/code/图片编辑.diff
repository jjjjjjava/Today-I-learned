+        float displayHeight = mSurfaceHeight * scaleY;
+        Log.d(TAG, "Final scale factors - X: " + String.format("%.4f", scaleX) + 
+                ", Y: " + String.format("%.4f", scaleY));
+        Log.d(TAG, "Actual display size in pixels: " + 
+                String.format("%.1f", displayWidth) + "x" + String.format("%.1f", displayHeight));
+        
+        // 璁＄畻榛戣竟灏哄
+        if (scaleX < 1.0f) {
+            float blackBorderWidth = (mSurfaceWidth - displayWidth) / 2;
+            Log.d(TAG, "Horizontal black borders: " + String.format("%.1f", blackBorderWidth) + " pixels on each side");
+        }
