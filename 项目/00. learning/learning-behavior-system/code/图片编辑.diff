@@ -0,0 +1,137 @@
+package com.ovopark.edit.gl;
+
+import android.content.Context;
+import android.opengl.GLES20;
+import android.util.Log;
+
+import com.ovopark.edit.R;
+import com.ovopark.edit.gl.utils.ShaderUtils;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Shader 绠＄悊鍣?+ * 璐熻矗绠＄悊鍜岀紦瀛樻墍鏈?Shader 绋嬪簭
+ * 
+ * @author panruiqi
+ * @since 1.0.0
+ */
+public class ShaderManager {
+    
+    private static final String TAG = "ShaderManager";
+    
+    /**
+     * Shader 绋嬪簭绫诲瀷
+     */
+    public enum ShaderType {
+        SHAPE,          // 鍑犱綍褰㈢姸 Shader
+        TEXTURE,        // 绾圭悊 Shader
+        BLEND           // 娣峰悎 Shader
+    }
+    
+    private final Context mContext;
+    
+    /**
+     * Shader 绋嬪簭缂撳瓨
+     * Key: ShaderType, Value: Program ID
+     */
+    private final Map<ShaderType, Integer> mProgramCache = new HashMap<>();
+    
+    public ShaderManager(Context context) {
+        this.mContext = context.getApplicationContext();
+    }
+    
+    /**
+     * 鍒濆鍖栨墍鏈?Shader 绋嬪簭
+     * 蹇呴』鍦?OpenGL 绾跨▼涓皟鐢?+     */
+    public void initShaders() {
+        Log.d(TAG, "Initializing shaders...");
+        
+        // 鍒涘缓褰㈢姸 Shader
+        int shapeProgram = ShaderUtils.createProgram(
+                mContext,
+                R.raw.shape_vertex_shader,
+                R.raw.shape_fragment_shader
+        );
+        
+        if (shapeProgram != 0) {
+            mProgramCache.put(ShaderType.SHAPE, shapeProgram);
+            Log.d(TAG, "Shape shader initialized: " + shapeProgram);
+        } else {
+            Log.e(TAG, "Failed to initialize shape shader");
+        }
+        
+        // 鍒涘缓绾圭悊 Shader
+        int textureProgram = ShaderUtils.createProgram(
+                mContext,
+                R.raw.texture_vertex_shader,
+                R.raw.texture_fragment_shader
+        );
+        
+        if (textureProgram != 0) {
+            mProgramCache.put(ShaderType.TEXTURE, textureProgram);
+            Log.d(TAG, "Texture shader initialized: " + textureProgram);
+        } else {
+            Log.e(TAG, "Failed to initialize texture shader");
+        }
+    }
+    
+    /**
+     * 鑾峰彇 Shader 绋嬪簭 ID
+     * 
+     * @param type Shader 绫诲瀷
+     * @return 绋嬪簭 ID锛屽鏋滄湭鎵惧埌杩斿洖 0
+     */
+    public int getProgram(ShaderType type) {
+        Integer program = mProgramCache.get(type);
+        return program != null ? program : 0;
+    }
+    
+    /**
+     * 浣跨敤鎸囧畾鐨?Shader 绋嬪簭
+     * 
+     * @param type Shader 绫诲瀷
+     * @return true 濡傛灉鎴愬姛
+     */
+    public boolean useProgram(ShaderType type) {
+        int program = getProgram(type);
+        if (program == 0) {
+            Log.e(TAG, "Program not found for type: " + type);
+            return false;
+        }
+        
+        GLES20.glUseProgram(program);
+        return true;
+    }
+    
+    /**
+     * 閲婃斁鎵€鏈?Shader 璧勬簮
+     * 蹇呴』鍦?OpenGL 绾跨▼涓皟鐢?+     */
+    public void release() {
+        Log.d(TAG, "Releasing shaders...");
+        
+        for (Map.Entry<ShaderType, Integer> entry : mProgramCache.entrySet()) {
+            int program = entry.getValue();
+            if (program != 0) {
+                GLES20.glDeleteProgram(program);
+                Log.d(TAG, "Deleted shader program: " + entry.getKey() + " (ID: " + program + ")");
+            }
+        }
+        
+        mProgramCache.clear();
+    }
+    
+    /**
+     * 妫€鏌?Shader 鏄惁宸插垵濮嬪寲
+     * 
+     * @param type Shader 绫诲瀷
+     * @return true 濡傛灉宸插垵濮嬪寲
+     */
+    public boolean isInitialized(ShaderType type) {
+        return mProgramCache.containsKey(type) && mProgramCache.get(type) != 0;
+    }
+}
+
