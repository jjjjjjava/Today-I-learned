+    private void calculateImageTransform() {
+        Log.d(TAG, "-------- calculateImageTransform START --------");
+        
+        if (mSurfaceWidth == 0 || mSurfaceHeight == 0 || 
+            mImageWidth == 0 || mImageHeight == 0) {
+            Log.w(TAG, "Invalid dimensions - Surface: " + mSurfaceWidth + "x" + mSurfaceHeight + 
