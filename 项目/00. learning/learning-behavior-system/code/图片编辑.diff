+        Log.d(TAG, "Scale factors saved for cropping: X=" + String.format("%.4f", mImageScaleX) + 
+                ", Y=" + String.format("%.4f", mImageScaleY));
+        Log.d(TAG, "-------- calculateImageTransform END --------");
+    }
