+package com.ovopark.edit.gl.command;
+
+import com.ovopark.edit.gl.tool.Shape;
+
+import java.util.List;
+
+/**
+ * 缁樺埗褰㈢姸鍛戒护
+ * 鐢ㄤ簬鎾ら攢/閲嶅仛缁樺埗鎿嶄綔
+ * 
+ * @author panruiqi
+ * @since 1.0.0
+ */
+public class DrawShapeCommand implements ICommand {
+    
+    private final List<Shape> shapeList;
+    private final Shape shape;
+    private final long timestamp;
+    
+    /**
+     * 鏋勯€犲嚱鏁?+     * 
+     * @param shapeList 褰㈢姸鍒楄〃锛堝紩鐢級
+     * @param shape 瑕佺粯鍒剁殑褰㈢姸锛堜細鍒涘缓鍓湰锛?+     */
+    public DrawShapeCommand(List<Shape> shapeList, Shape shape) {
+        this.shapeList = shapeList;
+        // 鍒涘缓褰㈢姸鍓湰锛岄伩鍏嶅閮ㄤ慨鏀?+        this.shape = new Shape(shape);
+        this.timestamp = System.currentTimeMillis();
+    }
+    
+    @Override
+    public void execute() {
+        if (shapeList != null && shape != null) {
+            shapeList.add(shape);
+        }
+    }
+    
+    @Override
+    public void undo() {
+        if (shapeList != null && shape != null) {
+            shapeList.remove(shape);
+        }
+    }
+    
+    @Override
+    public void redo() {
+        // 閲嶅仛灏辨槸鍐嶆鎵ц
+        execute();
+    }
+    
+    @Override
+    public String getDescription() {
+        return "Draw Shape: " + (shape != null ? shape.toString() : "null");
+    }
+    
+    @Override
+    public long getTimestamp() {
+        return timestamp;
+    }
+    
+    /**
+     * 鑾峰彇鍏宠仈鐨勫舰鐘跺璞?+     * 
+     * @return 褰㈢姸瀵硅薄
+     */
+    public Shape getShape() {
+        return shape;
+    }
+}
