+     * 璁剧疆鍩虹鍥剧墖
+     * 
+     * @param bitmap 鍥剧墖
+     */
+    public void setBaseImage(Bitmap bitmap) {
+        if (bitmap == null) {
+            Log.e(TAG, "Base bitmap is null");
+            return;
+        }
+        
+        mRenderer.setBaseBitmap(bitmap);
+        requestRender();
+        
+        Log.d(TAG, "Base image set: " + bitmap.getWidth() + "x" + bitmap.getHeight());
+    }
+    
+    /**
+     * 璁剧疆褰撳墠宸ュ叿
+     * 
+     * @param toolType 宸ュ叿绫诲瀷
+     */
+    public void setCurrentTool(ToolType toolType) {
+        Log.d(TAG, "setCurrentTool() called with: " + (toolType != null ? toolType.getDisplayName() : "NULL"));
+        
+        if (toolType == null) {
+            Log.w(TAG, "Tool type is null");
+            return;
+        }
+        
+        // 妫€鏌ュ伐鍏锋槸鍚﹀凡鍒濆鍖?+        boolean toolsReady = (mArrowTool != null && mRectangleTool != null);
+        if (!toolsReady) {
+            Log.w(TAG, "Tools not initialized yet, saving as pending: " + toolType.getDisplayName());
+            mPendingToolType = toolType;
+            return;
+        }
+        
+        // 濡傛灉鍒囨崲鐨勬槸 OpenGL 宸ュ叿锛屽厛鎻愪氦褰撳墠宸ュ叿鐨勫舰鐘跺埌鍏变韩灞?+        if (mCurrentTool != null && toolType.isOpenGLTool() && mCurrentTool.getToolType().isOpenGLTool()) {
+            Log.d(TAG, "Committing current tool before switch: " + mCurrentTool.getToolType().getDisplayName());
+            commitCurrentTool();
+        }
+        
+        // 闅愯棌褰撳墠宸ュ叿
+        if (mCurrentTool != null) {
+            Log.d(TAG, "Hiding current tool: " + mCurrentTool.getToolType().getDisplayName());
+            mCurrentTool.onHide();
+        }
+        
+        // 鍒囨崲宸ュ叿
+        switch (toolType) {
+            case ARROW:
+                mCurrentTool = mArrowTool;
+                Log.d(TAG, "Switching to ArrowTool, instance=" + mArrowTool);
+                break;
+            case RECTANGLE:
+                mCurrentTool = mRectangleTool;
+                Log.d(TAG, "Switching to RectangleTool, instance=" + mRectangleTool);
+                break;
+            default:
+                Log.w(TAG, "Unsupported tool type: " + toolType);
+                return;
+        }
+        
+        // 鏄剧ず鏂板伐鍏?+        if (mCurrentTool != null) {
+            // 璁剧疆瑙嗗彛灏哄锛堝鏋滃凡缁忓垵濮嬪寲锛?+            if (mViewWidth > 0 && mViewHeight > 0) {
+                mCurrentTool.setViewportSize(mViewWidth, mViewHeight);
+            }
+            
+            mCurrentTool.onShow();
+            mRenderer.setCurrentTool(mCurrentTool);
+            Log.d(TAG, "Tool switched successfully to: " + toolType.getDisplayName());
+        } else {
+            Log.e(TAG, "Tool is NULL after switch! This should not happen!");
+        }
+        
+        requestRender();
+    }
+    
+    /**
+     * 鑾峰彇褰撳墠宸ュ叿
+     * 
+     * @return 褰撳墠宸ュ叿瀹炰緥
+     */
+    public IEditTool getCurrentTool() {
+        return mCurrentTool;
+    }
+    
+    /**
+     * 璁剧疆缁樺埗鐘舵€佺洃鍚櫒
+     * 
+     * @param listener 鐩戝惉鍣?+     */
+    public void setOnDrawingStateChangeListener(OnDrawingStateChangeListener listener) {
+        mDrawingStateListener = listener;
+        Log.d(TAG, "Drawing state listener set: " + (listener != null));
+    }
+    
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        // 璋冭瘯鏃ュ織锛氳拷韪Е鎽镐簨浠跺埌杈?GLEditView
+        String action = "";
+        switch (event.getAction()) {
+            case MotionEvent.ACTION_DOWN:
+                action = "ACTION_DOWN";
+                break;
+            case MotionEvent.ACTION_MOVE:
+                action = "ACTION_MOVE";
+                break;
+            case MotionEvent.ACTION_UP:
+                action = "ACTION_UP";
+                break;
+            case MotionEvent.ACTION_CANCEL:
+                action = "ACTION_CANCEL";
+                break;
+        }
+        Log.d(TAG, "onTouchEvent: " + action + ", x=" + event.getX() + ", y=" + event.getY() + 
+                ", mCurrentTool=" + (mCurrentTool != null ? mCurrentTool.getToolType().getDisplayName() : "NULL"));
+        
+        if (mCurrentTool == null) {
+            Log.w(TAG, "onTouchEvent: mCurrentTool is NULL! Event not handled.");
+            return super.onTouchEvent(event);
+        }
+        
+        // 灏嗗睆骞曞潗鏍囪浆鎹负 OpenGL 鍧愭爣绯伙紙-1.0 ~ 1.0锛?+        float x = (event.getX() / getWidth()) * 2.0f - 1.0f;
+        float y = -((event.getY() / getHeight()) * 2.0f - 1.0f);
+        
+        Log.d(TAG, "Converted to GL coords: x=" + x + ", y=" + y);
+        
+        boolean handled = false;
+        
+        switch (event.getAction()) {
+            case MotionEvent.ACTION_DOWN:
+                handled = mCurrentTool.onTouchDown(x, y);
+                Log.d(TAG, "Tool onTouchDown returned: " + handled);
+                break;
+            case MotionEvent.ACTION_MOVE:
+                handled = mCurrentTool.onTouchMove(x, y);
+                break;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                handled = mCurrentTool.onTouchUp(x, y);
+                Log.d(TAG, "Tool onTouchUp returned: " + handled);
+                
+                // 缁樺埗瀹屾垚锛岄€氱煡鐩戝惉鍣ㄦ洿鏂?UI
+                if (handled && mDrawingStateListener != null) {
+                    post(new Runnable() {
+                        @Override
+                        public void run() {
+                            Log.d(TAG, "Notifying drawing complete listener");
+                            mDrawingStateListener.onDrawingComplete();
+                        }
+                    });
+                }
+                break;
+        }
+        
+        if (handled) {
+            requestRender();
+            Log.d(TAG, "Render requested");
+        }
+        
+        boolean result = handled || super.onTouchEvent(event);
+        Log.d(TAG, "onTouchEvent returning: " + result);
+        return result;
+    }
+    
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+        mViewWidth = w;
+        mViewHeight = h;
+        Log.d(TAG, "Size changed: " + w + "x" + h);
+        
+        // 鏇存柊鎵€鏈夊伐鍏风殑瑙嗗彛灏哄
+        updateToolsViewportSize();
+    }
+    
+    /**
+     * 鏇存柊鎵€鏈夊伐鍏风殑瑙嗗彛灏哄
+     */
+    private void updateToolsViewportSize() {
+        if (mViewWidth > 0 && mViewHeight > 0) {
+            if (mArrowTool != null) {
+                mArrowTool.setViewportSize(mViewWidth, mViewHeight);
+            }
+            if (mRectangleTool != null) {
+                mRectangleTool.setViewportSize(mViewWidth, mViewHeight);
+            }
+            if (mCurrentTool != null) {
+                mCurrentTool.setViewportSize(mViewWidth, mViewHeight);
+            }
+        }
+    }
+    
+    /**
+     * 鎾ら攢褰撳墠宸ュ叿鐨勪笂涓€涓搷浣?+     * 
+     * @return 鏄惁鎴愬姛
+     */
+    public boolean undo() {
+        if (mCurrentTool != null && mCurrentTool.canUndo()) {
+            boolean result = mCurrentTool.undo();
+            requestRender();
+            
+            // 閫氱煡鐩戝惉鍣ㄧ姸鎬佸凡鍙樺寲
+            if (mDrawingStateListener != null) {
+                post(new Runnable() {
+                    @Override
+                    public void run() {
+                        mDrawingStateListener.onUndoRedoStateChanged();
+                    }
+                });
+            }
+            return result;
+        }
+        return false;
+    }
+    
+    /**
+     * 閲嶅仛褰撳墠宸ュ叿鐨勬搷浣?+     * 
+     * @return 鏄惁鎴愬姛
+     */
+    public boolean redo() {
+        if (mCurrentTool != null && mCurrentTool.canRedo()) {
+            boolean result = mCurrentTool.redo();
+            requestRender();
+            
+            // 閫氱煡鐩戝惉鍣ㄧ姸鎬佸凡鍙樺寲
+            if (mDrawingStateListener != null) {
+                post(new Runnable() {
+                    @Override
+                    public void run() {
+                        mDrawingStateListener.onUndoRedoStateChanged();
+                    }
+                });
+            }
+            return result;
+        }
+        return false;
+    }
+    
+    /**
+     * 鏄惁鍙互鎾ら攢
+     * 
+     * @return true 濡傛灉鍙互鎾ら攢
+     */
+    public boolean canUndo() {
+        return mCurrentTool != null && mCurrentTool.canUndo();
+    }
+    
+    /**
+     * 鏄惁鍙互閲嶅仛
+     * 
+     * @return true 濡傛灉鍙互閲嶅仛
+     */
+    public boolean canRedo() {
+        return mCurrentTool != null && mCurrentTool.canRedo();
+    }
+    
+    /**
+     * 鍥哄寲褰撳墠宸ュ叿鐨勫唴瀹瑰埌搴曢儴绾圭悊锛堝紓姝ワ級
+     * 鐢ㄤ簬宸ュ叿鍒囨崲鏃朵繚鐣欎箣鍓嶇殑缁樺埗鍐呭
+     */
+    public void commitCurrentTool() {
+        if (mCurrentTool == null) {
+            Log.w(TAG, "commitCurrentTool: mCurrentTool is null");
+            return;
+        }
+        
+        if (!(mCurrentTool instanceof BaseDrawingTool)) {
+            Log.w(TAG, "commitCurrentTool: Current tool is not a BaseDrawingTool");
+            return;
+        }
+        
+        BaseDrawingTool drawingTool = (BaseDrawingTool) mCurrentTool;
+        
+        if (drawingTool.getShapeList() == null || drawingTool.getShapeList().isEmpty()) {
+            Log.d(TAG, "commitCurrentTool: No shapes to commit");
+            return;
+        }
+        
+        Log.d(TAG, "Committing current tool to texture (async)");
+        
+        // 寮傛鎵ц锛屼笉闃诲涓荤嚎绋?+        queueEvent(new Runnable() {
+            @Override
+            public void run() {
+                try {
+                    mRenderer.commitToTexture();
+                    Log.d(TAG, "commitToTexture completed");
+                    
+                    // 鍥哄寲瀹屾垚鍚庢竻绌哄綋鍓嶅伐鍏?+                    post(new Runnable() {
+                        @Override
+                        public void run() {
+                            if (mCurrentTool instanceof BaseDrawingTool) {
+                                ((BaseDrawingTool) mCurrentTool).reset();
+                            }
+                            requestRender();
+                        }
+                    });
+                } catch (Exception e) {
+                    Log.e(TAG, "Failed to commit to texture", e);
+                }
+            }
+        });
+    }
+    
+    /**
+     * 閲嶇疆褰撳墠宸ュ叿
+     */
+    public void reset() {
+        if (mCurrentTool != null) {
+            mCurrentTool.reset();
+            requestRender();
+        }
+    }
+    
+    /**
+     * 娓呯┖鎵€鏈夊唴瀹?+     */
+    public void clearAll() {
+        // 娓呯┖褰撳墠宸ュ叿
+        if (mCurrentTool != null) {
+            mCurrentTool.reset();
+            requestRender();
+        }
+    }
+    
+    /**
+     * 鏄惁鏈夋湭淇濆瓨鐨勬洿鏀?+     * 
+     * @return true 濡傛灉鏈夋湭淇濆瓨鐨勫唴瀹?+     */
+    public boolean hasUnsavedChanges() {
+        return mCurrentTool != null && mCurrentTool.hasUnsavedChanges();
+    }
+    
+    /**
+     * 鎹曡幏褰撳墠娓叉煋缁撴灉涓?Bitmap
+     * 姝ゆ柟娉曞皢鍦?GL 绾跨▼涓墽琛屾崟鑾凤紝骞跺湪涓荤嚎绋嬪洖璋?+     * 
+     * @param callback 鎹曡幏鍥炶皟
+     */
+    public void captureResult(final CaptureResultCallback callback) {
+        if (callback == null) {
+            Log.w(TAG, "captureResult: callback is null");
+            return;
+        }
+        
+        // 鍦?GL 绾跨▼涓墽琛屾崟鑾?+        queueEvent(new Runnable() {
+            @Override
+            public void run() {
+                mRenderer.captureResult(new GLEditRenderer.CaptureCallback() {
+                    @Override
+                    public void onCapture(final Bitmap bitmap) {
+                        // 鍦ㄤ富绾跨▼鍥炶皟
+                        post(new Runnable() {
+                            @Override
+                            public void run() {
+                                callback.onCaptureSuccess(bitmap);
+                            }
+                        });
+                    }
+                    
+                    @Override
+                    public void onError(final String error) {
+                        // 鍦ㄤ富绾跨▼鍥炶皟
+                        post(new Runnable() {
+                            @Override
+                            public void run() {
+                                callback.onCaptureError(error);
+                            }
+                        });
+                    }
+                });
+            }
+        });
+    }
+    
+    /**
+     * 鎹曡幏缁撴灉鍥炶皟鎺ュ彛
+     */
+    public interface CaptureResultCallback {
+        /**
+         * 鎹曡幏鎴愬姛
+         * 
+         * @param bitmap 鎹曡幏鐨勪綅鍥?+         */
+        void onCaptureSuccess(Bitmap bitmap);
+        
+        /**
+         * 鎹曡幏澶辫触
+         * 
+         * @param error 閿欒淇℃伅
+         */
+        void onCaptureError(String error);
+    }
+    
+    /**
+     * 閲婃斁璧勬簮
+     */
+    public void release() {
+        if (mArrowTool != null) {
+            mArrowTool.onDestroy();
+        }
+        if (mRectangleTool != null) {
+            mRectangleTool.onDestroy();
+        }
+        if (mRenderer != null) {
+            mRenderer.release();
+        }
+        Log.d(TAG, "GLEditView released");
+    }
+}
