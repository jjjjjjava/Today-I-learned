+            Log.d(TAG, "Image is WIDER than surface -> Scale Y to fit");
+            Log.d(TAG, "ScaleY calculation: surfaceRatio / imageRatio = " + 
+                    String.format("%.4f", surfaceRatio) + " / " + 
+                    String.format("%.4f", imageRatio) + " = " + 
+                    String.format("%.4f", scaleY));
+        } else {
+            // 鍥剧墖姣斿睆骞曟洿楂橈紙鎴栫浉绛夛級锛屼互楂樺害涓哄噯
+            // 瀹藉害闇€瑕佺缉灏忎互淇濇寔瀹介珮姣?+            scaleX = imageRatio / surfaceRatio;
+            Log.d(TAG, "Image is TALLER than surface -> Scale X to fit");
+            Log.d(TAG, "ScaleX calculation: imageRatio / surfaceRatio = " + 
+                    String.format("%.4f", imageRatio) + " / " + 
+                    String.format("%.4f", surfaceRatio) + " = " + 
+                    String.format("%.4f", scaleX));
+        }
+        
+        Matrix.setIdentityM(mModelMatrix, 0);
+        Matrix.scaleM(mModelMatrix, 0, scaleX, scaleY, 1.0f);
+        
+        // 淇濆瓨缂╂斁鍥犲瓙锛堢敤浜庡悗缁鍓粦杈癸級
