diff --git a/lib_edit/src/main/java/com/ovopark/edit/gl/tool/ArrowTool.java b/lib_edit/src/main/java/com/ovopark/edit/gl/tool/ArrowTool.java
new file mode 100644
index 0000000000..aba7db2916
--- /dev/null
+++ b/lib_edit/src/main/java/com/ovopark/edit/gl/tool/ArrowTool.java
@@ -0,0 +1,216 @@
+package com.ovopark.edit.gl.tool;
+
+import android.opengl.GLES20;
+import android.opengl.Matrix;
+import android.util.Log;
+
+import com.ovopark.edit.gl.ShaderManager;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.FloatBuffer;
+
+/**
+ * 绠ご缁樺埗宸ュ叿
+ * 浣跨敤 OpenGL 缁樺埗甯︾澶寸殑鐩寸嚎
+ * 
+ * 绠ご缁撴瀯锛?+ * 1. 涓荤嚎娈碉紙start -> end锛?+ * 2. 绠ご锛坋nd 澶勭殑涓や釜涓夎褰㈢繀鑶€锛?+ * 
+ * @author panruiqi
+ * @since 1.0.0
+ */
+public class ArrowTool extends BaseDrawingTool {
+    
+    private static final String TAG = "ArrowTool";
+    
+    /**
+     * 绠ご闀垮害绯绘暟锛堢浉瀵逛簬绾垮锛?+     */
+    private static final float ARROW_LENGTH_FACTOR = 15.0f;
+    
+    /**
+     * 绠ご瀹藉害绯绘暟锛堢浉瀵逛簬绾垮锛?+     */
+    private static final float ARROW_WIDTH_FACTOR = 8.0f;
+    
+    private final ShaderManager mShaderManager;
+    
+    /**
+     * Shader 鍙ユ焺
+     */
+    private int mPositionHandle = -1;
+    private int mColorHandle = -1;
+    private int mMVPMatrixHandle = -1;
+    
+    public ArrowTool(ShaderManager shaderManager) {
+        this.mShaderManager = shaderManager;
+    }
+    
+    @Override
+    public ToolType getToolType() {
+        return ToolType.ARROW;
+    }
+    
+    @Override
+    public void render(float[] mvpMatrix) {
+        if (mShaderManager == null) {
+            Log.e(TAG, "ShaderManager is null");
+            return;
+        }
+        
+        // 浣跨敤褰㈢姸 Shader
+        if (!mShaderManager.useProgram(ShaderManager.ShaderType.SHAPE)) {
+            Log.e(TAG, "Failed to use shape shader");
+            return;
+        }
+        
+        // 鑾峰彇 Shader 鍙ユ焺
+        int program = mShaderManager.getProgram(ShaderManager.ShaderType.SHAPE);
+        mPositionHandle = GLES20.glGetAttribLocation(program, "aPosition");
+        mColorHandle = GLES20.glGetUniformLocation(program, "uColor");
+        mMVPMatrixHandle = GLES20.glGetUniformLocation(program, "uMVPMatrix");
+        
+        // 娓叉煋鎵€鏈夊凡瀹屾垚鐨勭澶?+        for (Shape shape : mShapeList) {
+            renderArrow(shape, mvpMatrix);
+        }
+        
+        // 娓叉煋褰撳墠姝ｅ湪缁樺埗鐨勭澶?+        if (mIsDrawing && mCurrentShape != null) {
+            renderArrow(mCurrentShape, mvpMatrix);
+        }
+    }
+    
+    /**
+     * 娓叉煋鍗曚釜绠ご
+     * 
+     * @param shape 绠ご褰㈢姸鏁版嵁
+     * @param mvpMatrix MVP 鐭╅樀
+     */
+    private void renderArrow(Shape shape, float[] mvpMatrix) {
+        if (shape == null) {
+            return;
+        }
+        
+        // 鐢熸垚绠ご椤剁偣
+        float[] vertices = generateVertices(shape);
+        if (vertices == null || vertices.length == 0) {
+            return;
+        }
+        
+        // 鍒涘缓椤剁偣缂撳啿
+        FloatBuffer vertexBuffer = ByteBuffer.allocateDirect(vertices.length * 4)
+                .order(ByteOrder.nativeOrder())
+                .asFloatBuffer()
+                .put(vertices);
+        vertexBuffer.position(0);
+        
+        // 鍚敤椤剁偣鏁扮粍
+        GLES20.glEnableVertexAttribArray(mPositionHandle);
+        
+        // 璁剧疆椤剁偣鏁版嵁
+        GLES20.glVertexAttribPointer(
+                mPositionHandle,
+                2,              // 姣忎釜椤剁偣 2 涓潗鏍?(x, y)
+                GLES20.GL_FLOAT,
+                false,
+                0,
+                vertexBuffer
+        );
+        
+        // 璁剧疆棰滆壊
+        GLES20.glUniform4fv(mColorHandle, 1, shape.color, 0);
+        
+        // 璁剧疆 MVP 鐭╅樀
+        GLES20.glUniformMatrix4fv(mMVPMatrixHandle, 1, false, mvpMatrix, 0);
+        
+        // 缁樺埗绠ご锛堜笁瑙掑舰锛?+        GLES20.glDrawArrays(GLES20.GL_TRIANGLES, 0, vertices.length / 2);
+        
+        // 绂佺敤椤剁偣鏁扮粍
+        GLES20.glDisableVertexAttribArray(mPositionHandle);
+    }
+    
+    @Override
+    protected float[] generateVertices(Shape shape) {
+        if (shape == null) {
+            return new float[0];
+        }
+        
+        float x1 = shape.startX;
+        float y1 = shape.startY;
+        float x2 = shape.endX;
+        float y2 = shape.endY;
+        float width = shape.strokeWidth;
+        
+        // 璁＄畻绾挎鏂瑰悜鍚戦噺
+        float dx = x2 - x1;
+        float dy = y2 - y1;
+        float length = (float) Math.sqrt(dx * dx + dy * dy);
+        
+        // 濡傛灉绾挎澶煭锛屼笉缁樺埗
+        if (length < 0.001f) {
+            return new float[0];
+        }
+        
+        // 褰掍竴鍖栨柟鍚戝悜閲?+        float dirX = dx / length;
+        float dirY = dy / length;
+        
+        // 鍨傜洿鏂瑰悜鍚戦噺锛堢敤浜庤绠楃嚎瀹斤級
+        float perpX = -dirY;
+        float perpY = dirX;
+        
+        // 鏍规嵁瀹介珮姣旇皟鏁寸嚎瀹?+        // 璁＄畻鍨傜洿鍚戦噺鍦╔鍜孻鏂瑰悜鐨勫崰姣旓紝鐒跺悗搴旂敤涓嶅悓鐨勭嚎瀹?+        float adjustedWidth = width;
+        // 濡傛灉鍨傜洿鍚戦噺涓昏鍦╕鏂瑰悜锛屽簲鐢ㄥ楂樻瘮璋冩暣
+        if (Math.abs(perpY) > Math.abs(perpX)) {
+            adjustedWidth = width * mAspectRatio;
+        }
+        
+        // 璁＄畻绾挎鐨勫洓涓鐐?+        float halfWidth = adjustedWidth / 2.0f;
+        float lineX1 = x1 + perpX * halfWidth;
+        float lineY1 = y1 + perpY * halfWidth;
+        float lineX2 = x1 - perpX * halfWidth;
+        float lineY2 = y1 - perpY * halfWidth;
+        
+        // 绠ご灏鹃儴锛堢嚎娈垫湯绔線鍥炰竴鐐癸級
+        float arrowLength = width * ARROW_LENGTH_FACTOR;
+        float arrowTailX = x2 - dirX * arrowLength;
+        float arrowTailY = y2 - dirY * arrowLength;
+        
+        float lineX3 = arrowTailX + perpX * halfWidth;
+        float lineY3 = arrowTailY + perpY * halfWidth;
+        float lineX4 = arrowTailX - perpX * halfWidth;
+        float lineY4 = arrowTailY - perpY * halfWidth;
+        
+        // 绠ご瀹藉害
+        float arrowWidth = width * ARROW_WIDTH_FACTOR;
+        float arrowX1 = arrowTailX + perpX * arrowWidth / 2.0f;
+        float arrowY1 = arrowTailY + perpY * arrowWidth / 2.0f;
+        float arrowX2 = arrowTailX - perpX * arrowWidth / 2.0f;
+        float arrowY2 = arrowTailY - perpY * arrowWidth / 2.0f;
+        
+        // 杩斿洖椤剁偣鏁扮粍锛?涓笁瑙掑舰缁勬垚绾挎 + 1涓笁瑙掑舰缁勬垚绠ご锛?+        return new float[]{
+                // 绾挎鐭╁舰锛?涓笁瑙掑舰锛?+                lineX1, lineY1,     // 涓夎褰?1 - 椤剁偣 1
+                lineX2, lineY2,     // 涓夎褰?1 - 椤剁偣 2
+                lineX3, lineY3,     // 涓夎褰?1 - 椤剁偣 3
+                
+                lineX2, lineY2,     // 涓夎褰?2 - 椤剁偣 1
+                lineX3, lineY3,     // 涓夎褰?2 - 椤剁偣 2
+                lineX4, lineY4,     // 涓夎褰?2 - 椤剁偣 3
+                
+                // 绠ご涓夎褰?+                arrowX1, arrowY1,   // 绠ご宸︿晶
+                arrowX2, arrowY2,   // 绠ご鍙充晶
+                x2, y2              // 绠ご灏栫
+        };
+    }
+}
+
diff --git a/lib_edit/src/main/java/com/ovopark/edit/gl/tool/BaseDrawingTool.java b/lib_edit/src/main/java/com/ovopark/edit/gl/tool/BaseDrawingTool.java
new file mode 100644
index 0000000000..a07b078eaf
--- /dev/null
+++ b/lib_edit/src/main/java/com/ovopark/edit/gl/tool/BaseDrawingTool.java
@@ -0,0 +1,461 @@
+package com.ovopark.edit.gl.tool;
+
+import android.util.Log;
+
+import com.ovopark.edit.gl.command.CommandHistory;
+import com.ovopark.edit.gl.command.DrawShapeCommand;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+
+/**
+ * 鍑犱綍缁樺浘宸ュ叿鎶借薄鍩虹被
+ * 鎻愪緵鎵€鏈夊嚑浣曠粯鍥惧伐鍏风殑閫氱敤鍔熻兘
+ * 
+ * 瀛愮被鍙渶瀹炵幇锛?+ * 1. generateVertices() - 鐢熸垚椤剁偣鏁版嵁
+ * 2. render() - OpenGL 娓叉煋閫昏緫
+ * 
+ * @author panruiqi
+ * @since 1.0.0
+ */
+public abstract class BaseDrawingTool implements IEditTool {
+    
+    protected static final String TAG = "BaseDrawingTool";
+    
+    /**
+     * 褰㈢姸鍒楄〃锛堢嚎绋嬪畨鍏級
+     */
+    protected final CopyOnWriteArrayList<Shape> mShapeList = new CopyOnWriteArrayList<>();
+    
+    /**
+     * 鍛戒护鍘嗗彶绠＄悊鍣?+     */
+    protected final CommandHistory mCommandHistory = new CommandHistory();
+    
+    /**
+     * 褰撳墠缁樺埗涓殑褰㈢姸锛堜复鏃讹級
+     */
+    protected Shape mCurrentShape = null;
+    
+    /**
+     * 褰撳墠棰滆壊锛圧GBA锛?+     */
+    protected float[] mCurrentColor = new float[]{1.0f, 0.0f, 0.0f, 1.0f};
+    
+    /**
+     * 褰撳墠绾垮
+     */
+    protected float mCurrentStrokeWidth = 0.01f;
+    
+    /**
+     * 瑙嗗彛瀹介珮姣旓紙width / height锛?+     */
+    protected float mAspectRatio = 1.0f;
+    
+    /**
+     * 鏄惁姝ｅ湪缁樺埗
+     */
+    protected boolean mIsDrawing = false;
+    
+    /**
+     * 鏄惁姝ｅ湪鎷栨嫿宸叉湁褰㈢姸
+     */
+    protected boolean mIsDragging = false;
+    
+    /**
+     * 姝ｅ湪琚嫋鎷界殑褰㈢姸
+     */
+    protected Shape mDraggedShape = null;
+    
+    /**
+     * 鎷栨嫿璧峰鐐?X锛堢敤浜庤绠楀亸绉伙級
+     */
+    protected float mDragStartX = 0f;
+    
+    /**
+     * 鎷栨嫿璧峰鐐?Y锛堢敤浜庤绠楀亸绉伙級
+     */
+    protected float mDragStartY = 0f;
+    
+    /**
+     * 琚嫋鎷藉舰鐘剁殑鍘熷璧风偣 X锛堣褰曟嫋鎷藉墠鐨勪綅缃級
+     */
+    protected float mOriginalStartX = 0f;
+    
+    /**
+     * 琚嫋鎷藉舰鐘剁殑鍘熷璧风偣 Y
+     */
+    protected float mOriginalStartY = 0f;
+    
+    /**
+     * 琚嫋鎷藉舰鐘剁殑鍘熷缁堢偣 X
+     */
+    protected float mOriginalEndX = 0f;
+    
+    /**
+     * 琚嫋鎷藉舰鐘剁殑鍘熷缁堢偣 Y
+     */
+    protected float mOriginalEndY = 0f;
+    
+    /**
+     * 琚嫋鎷藉舰鐘剁殑鍘熷閫忔槑搴︼紙鐢ㄤ簬鎭㈠锛?+     */
+    protected float mOriginalAlpha = 1.0f;
+    
+    /**
+     * 纰版挒妫€娴嬮槇鍊硷紙OpenGL 鍧愭爣绯诲崟浣嶏級
+     * 0.08f 鐩稿綋浜庡睆骞曞搴︾殑 4%锛屼究浜庣偣鍑?+     */
+    protected static final float HIT_TEST_THRESHOLD = 0.08f;
+    
