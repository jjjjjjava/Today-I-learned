+        Log.d(TAG, "Image size: " + mImageWidth + "x" + mImageHeight + 
+                " (ratio: " + String.format("%.4f", imageRatio) + ")");
+        
+        float scaleX = 1.0f;
+        float scaleY = 1.0f;
+        
+        // FIT_CENTER 閫昏緫锛?+        // 1. 濡傛灉鍥剧墖鏇村锛坕mageRatio > surfaceRatio锛夛紝鍒欏搴﹀～婊★紝楂樺害鎸夋瘮渚嬬缉灏?+        // 2. 濡傛灉鍥剧墖鏇撮珮锛坕mageRatio < surfaceRatio锛夛紝鍒欓珮搴﹀～婊★紝瀹藉害鎸夋瘮渚嬬缉灏?+        
+        if (imageRatio > surfaceRatio) {
