+package com.ovopark.edit.gl.tool;
+
+/**
+ * 缂栬緫宸ュ叿绫诲瀷鏋氫妇
+ * 
+ * @author panruiqi
+ * @since 1.0.0
+ */
+public enum ToolType {
+    /**
+     * 绠ご宸ュ叿
+     */
+    ARROW("arrow", "绠ご"),
+    
+    /**
+     * 鐭╁舰宸ュ叿
+     */
+    RECTANGLE("rectangle", "鐭╁舰"),
+    
+    /**
+     * 鍦嗗舰宸ュ叿锛堥鐣欙級
+     */
+    CIRCLE("circle", "鍦嗗舰"),
+    
+    /**
+     * 鐩寸嚎宸ュ叿锛堥鐣欙級
+     */
+    LINE("line", "鐩寸嚎"),
+    
+    /**
+     * 婊ら暅宸ュ叿锛堥鐣欙級
+     */
